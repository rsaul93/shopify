{% doc %}
  @prompt
    Refactor the existing block to reduce its height on mobile devices. Add visual indicators that show there are multiple products in a horizontal scrollable row, such as: partial visibility of the next product card peeking from the right edge, subtle fade gradient on the right side, or pagination dots. Ensure the layout uses horizontal scroll with snap points for smooth swiping between products on mobile viewports.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-scroll-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding: {{ block.settings.section_padding_desktop }}px 0;
  }

  .ai-product-scroll__container-{{ ai_gen_id }} {
    max-width: {{ settings.page_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-product-scroll__header-{{ ai_gen_id }} {
    margin-bottom: 24px;
  }

  .ai-product-scroll__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size_desktop }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 8px;
    font-family: {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }};
    font-weight: {{ settings.type_header_font.weight }};
  }

  .ai-product-scroll__subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0;
  }

  .ai-product-scroll__wrapper-{{ ai_gen_id }} {
    position: relative;
  }

  .ai-product-scroll__track-{{ ai_gen_id }} {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - {{ block.settings.gap_desktop }}px * ({{ block.settings.products_per_row_desktop | minus: 1 }})) / {{ block.settings.products_per_row_desktop }});
    gap: {{ block.settings.gap_desktop }}px;
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
    scroll-snap-type: x mandatory;
    padding-bottom: 10px;
  }

  .ai-product-scroll__track-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-product-scroll__card-{{ ai_gen_id }} {
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    background: {{ block.settings.card_background }};
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-product-scroll__card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
  }

  .ai-product-scroll__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: {{ block.settings.image_ratio }}%;
    background: {{ settings.colors_img_background }};
    overflow: hidden;
  }

  .ai-product-scroll__image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-product-scroll__badge-{{ ai_gen_id }} {
    position: absolute;
    top: 12px;
    left: 12px;
    background: {{ block.settings.badge_background }};
    color: {{ block.settings.badge_text_color }};
    padding: 6px 12px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
  }

  .ai-product-scroll__content-{{ ai_gen_id }} {
    padding: {{ block.settings.card_padding }}px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex-grow: 1;
  }

  .ai-product-scroll__vendor-{{ ai_gen_id }} {
    font-size: 12px;
    color: {{ block.settings.text_color }};
    opacity: 0.7;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .ai-product-scroll__product-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_title_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0;
    line-height: 1.3;
    font-weight: 600;
  }

  .ai-product-scroll__product-title-link-{{ ai_gen_id }} {
    color: inherit;
    text-decoration: none;
  }

  .ai-product-scroll__product-title-link-{{ ai_gen_id }}:hover {
    color: {{ settings.colors_accent }};
  }

  .ai-product-scroll__price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_size }}px;
    color: {{ settings.colors_price }};
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .ai-product-scroll__price--sale-{{ ai_gen_id }} {
    color: {{ settings.colors_sale_price }};
  }

  .ai-product-scroll__compare-price-{{ ai_gen_id }} {
    text-decoration: line-through;
    opacity: 0.6;
    font-size: 0.9em;
  }

  .ai-product-scroll__button-{{ ai_gen_id }} {
    margin-top: auto;
    padding: 12px 20px;
    background: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    border: {{ settings.button_border_thickness }}px solid {{ block.settings.button_border_color }};
    border-radius: {{ settings.button_corner_radius }}px;
    font-size: {{ settings.type_button_size }}px;
    font-weight: 600;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.3s ease;
    display: block;
  }

  .ai-product-scroll__button-{{ ai_gen_id }}:hover {
    background: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
    transform: translateY(-2px);
  }

  .ai-product-scroll__fade-{{ ai_gen_id }} {
    display: none;
  }

  .ai-product-scroll__dots-{{ ai_gen_id }} {
    display: none;
  }

  .ai-product-scroll__empty-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: {{ block.settings.text_color }};
    opacity: 0.6;
  }

  @media screen and (max-width: 749px) {
    .ai-product-scroll-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_mobile }}px 0;
    }

    .ai-product-scroll__container-{{ ai_gen_id }} {
      padding: 0;
    }

    .ai-product-scroll__header-{{ ai_gen_id }} {
      padding: 0 16px;
      margin-bottom: 16px;
    }

    .ai-product-scroll__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_mobile }}px;
    }

    .ai-product-scroll__wrapper-{{ ai_gen_id }} {
      position: relative;
    }

    .ai-product-scroll__track-{{ ai_gen_id }} {
      grid-auto-columns: {{ block.settings.card_width_mobile }}%;
      gap: {{ block.settings.gap_mobile }}px;
      padding: 0 16px 16px;
      scroll-padding: 0 16px;
    }

    .ai-product-scroll__card-{{ ai_gen_id }} {
      min-height: auto;
    }

    .ai-product-scroll__image-wrapper-{{ ai_gen_id }} {
      padding-bottom: {{ block.settings.image_ratio_mobile }}%;
    }

    .ai-product-scroll__content-{{ ai_gen_id }} {
      padding: {{ block.settings.card_padding_mobile }}px;
    }

    .ai-product-scroll__product-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.product_title_size_mobile }}px;
    }

    .ai-product-scroll__fade-{{ ai_gen_id }} {
      display: block;
      position: absolute;
      top: 0;
      right: 0;
      width: 60px;
      height: calc(100% - 40px);
      background: linear-gradient(to left, {{ block.settings.fade_color }}, transparent);
      pointer-events: none;
      z-index: 1;
      opacity: 1;
      transition: opacity 0.3s ease;
    }

    .ai-product-scroll__fade--hidden-{{ ai_gen_id }} {
      opacity: 0;
    }

    .ai-product-scroll__dots-{{ ai_gen_id }} {
      display: flex;
      justify-content: center;
      gap: 8px;
      margin-top: 16px;
      padding: 0 16px;
    }

    .ai-product-scroll__dot-{{ ai_gen_id }} {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: {{ block.settings.dot_color }};
      opacity: 0.3;
      transition: opacity 0.3s ease, transform 0.3s ease;
      cursor: pointer;
    }

    .ai-product-scroll__dot--active-{{ ai_gen_id }} {
      opacity: 1;
      transform: scale(1.2);
    }
  }
{% endstyle %}

<product-scroll-{{ ai_gen_id }} class="ai-product-scroll-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-product-scroll__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank or block.settings.subtitle != blank %}
      <div class="ai-product-scroll__header-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-product-scroll__title-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}
        {% if block.settings.subtitle != blank %}
          <p class="ai-product-scroll__subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</p>
        {% endif %}
      </div>
    {% endif %}

    {% if block.settings.product_list != blank %}
      <div class="ai-product-scroll__wrapper-{{ ai_gen_id }}">
        <div class="ai-product-scroll__track-{{ ai_gen_id }}" data-scroll-track>
          {% for product in block.settings.product_list %}
            <div class="ai-product-scroll__card-{{ ai_gen_id }}">
              <a href="{{ product.url }}" class="ai-product-scroll__image-wrapper-{{ ai_gen_id }}">
                {% if product.featured_image %}
                  <img
                    src="{{ product.featured_image | image_url: width: 600 }}"
                    alt="{{ product.featured_image.alt | escape }}"
                    class="ai-product-scroll__image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="600"
                    height="{{ 600 | divided_by: product.featured_image.aspect_ratio | round }}"
                  >
                {% else %}
                  <div class="ai-product-scroll__image-{{ ai_gen_id }}">
                    {{ 'product-1' | placeholder_svg_tag }}
                  </div>
                {% endif %}

                {% if product.compare_at_price > product.price and block.settings.show_sale_badge %}
                  <span class="ai-product-scroll__badge-{{ ai_gen_id }}">{{ block.settings.sale_badge_text }}</span>
                {% endif %}
              </a>

              <div class="ai-product-scroll__content-{{ ai_gen_id }}">
                {% if block.settings.show_vendor and product.vendor != blank %}
                  <div class="ai-product-scroll__vendor-{{ ai_gen_id }}">{{ product.vendor }}</div>
                {% endif %}

                <h3 class="ai-product-scroll__product-title-{{ ai_gen_id }}">
                  <a href="{{ product.url }}" class="ai-product-scroll__product-title-link-{{ ai_gen_id }}">
                    {{ product.title }}
                  </a>
                </h3>

                {% if block.settings.show_price %}
                  <div class="ai-product-scroll__price-{{ ai_gen_id }} {% if product.compare_at_price > product.price %}ai-product-scroll__price--sale-{{ ai_gen_id }}{% endif %}">
                    <span>{{ product.price | money }}</span>
                    {% if product.compare_at_price > product.price %}
                      <span class="ai-product-scroll__compare-price-{{ ai_gen_id }}">{{ product.compare_at_price | money }}</span>
                    {% endif %}
                  </div>
                {% endif %}

                {% if block.settings.show_button %}
                  <a href="{{ product.url }}" class="ai-product-scroll__button-{{ ai_gen_id }}">
                    {{ block.settings.button_text }}
                  </a>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>

        <div class="ai-product-scroll__fade-{{ ai_gen_id }}" data-fade></div>
        <div class="ai-product-scroll__dots-{{ ai_gen_id }}" data-dots></div>
      </div>
    {% else %}
      <div class="ai-product-scroll__empty-{{ ai_gen_id }}">
        <p>Select products to display in this collection</p>
      </div>
    {% endif %}
  </div>
</product-scroll-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductScroll{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.track = this.querySelector('[data-scroll-track]');
        this.fade = this.querySelector('[data-fade]');
        this.dotsContainer = this.querySelector('[data-dots]');
        this.currentIndex = 0;
      }

      connectedCallback() {
        if (!this.track) return;

        if (window.innerWidth <= 749) {
          this.initMobile();
        }

        window.addEventListener('resize', () => {
          if (window.innerWidth <= 749) {
            this.initMobile();
          } else {
            this.cleanup();
          }
        });
      }

      initMobile() {
        this.createDots();
        this.updateFade();
        
        this.track.addEventListener('scroll', () => {
          this.updateFade();
          this.updateActiveDot();
        });

        if (this.dotsContainer) {
          this.dotsContainer.addEventListener('click', (e) => {
            if (e.target.classList.contains('ai-product-scroll__dot-{{ ai_gen_id }}')) {
              const index = parseInt(e.target.dataset.index);
              this.scrollToIndex(index);
            }
          });
        }
      }

      createDots() {
        if (!this.dotsContainer) return;
        
        const cards = this.track.querySelectorAll('.ai-product-scroll__card-{{ ai_gen_id }}');
        this.dotsContainer.innerHTML = '';
        
        cards.forEach((card, index) => {
          const dot = document.createElement('button');
          dot.className = 'ai-product-scroll__dot-{{ ai_gen_id }}';
          dot.dataset.index = index;
          dot.setAttribute('aria-label', `Go to product ${index + 1}`);
          
          if (index === 0) {
            dot.classList.add('ai-product-scroll__dot--active-{{ ai_gen_id }}');
          }
          
          this.dotsContainer.appendChild(dot);
        });
      }

      updateFade() {
        if (!this.fade) return;
        
        const scrollLeft = this.track.scrollLeft;
        const scrollWidth = this.track.scrollWidth;
        const clientWidth = this.track.clientWidth;
        const isAtEnd = scrollLeft + clientWidth >= scrollWidth - 10;
        
        if (isAtEnd) {
          this.fade.classList.add('ai-product-scroll__fade--hidden-{{ ai_gen_id }}');
        } else {
          this.fade.classList.remove('ai-product-scroll__fade--hidden-{{ ai_gen_id }}');
        }
      }

      updateActiveDot() {
        const cards = this.track.querySelectorAll('.ai-product-scroll__card-{{ ai_gen_id }}');
        const scrollLeft = this.track.scrollLeft;
        const cardWidth = cards[0]?.offsetWidth || 0;
        const gap = {{ block.settings.gap_mobile }};
        const index = Math.round(scrollLeft / (cardWidth + gap));
        
        const dots = this.dotsContainer.querySelectorAll('.ai-product-scroll__dot-{{ ai_gen_id }}');
        dots.forEach((dot, i) => {
          if (i === index) {
            dot.classList.add('ai-product-scroll__dot--active-{{ ai_gen_id }}');
          } else {
            dot.classList.remove('ai-product-scroll__dot--active-{{ ai_gen_id }}');
          }
        });
      }

      scrollToIndex(index) {
        const cards = this.track.querySelectorAll('.ai-product-scroll__card-{{ ai_gen_id }}');
        const card = cards[index];
        
        if (card) {
          const scrollLeft = card.offsetLeft - 16;
          this.track.scrollTo({
            left: scrollLeft,
            behavior: 'smooth'
          });
        }
      }

      cleanup() {
        if (this.dotsContainer) {
          this.dotsContainer.innerHTML = '';
        }
        if (this.fade) {
          this.fade.classList.remove('ai-product-scroll__fade--hidden-{{ ai_gen_id }}');
        }
      }
    }

    customElements.define('product-scroll-{{ ai_gen_id }}', ProductScroll{{ ai_gen_id }});
  })();
</script>


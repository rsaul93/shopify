{%- assign text_direction = 'localization.text_direction_trigger' | t | downcase -%}
<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}"
  {%- if text_direction == 'rtl' %} dir="rtl"{% endif -%}
>
  <head>
    <!-- cp-spedition-130-cache-bust-20260713b -->
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.colors_background | default: '#ffffff' }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {%- unless settings.type_header_font.system? and settings.type_body_font.system? -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- endunless -%}
    {%- if request.page_type == 'index' -%}
      {%- assign page_description = 'Smarte Campingausrüstung für Van, Wohnmobil, Boot und Outdoor-Abenteuer: ausgewählte Produkte, Beratung und schnelle Lieferung.' -%}
    {%- endif -%}


    {%- liquid
      if request.page_type == 'page' and template.suffix == 'geschaeftskunden'
        capture page_title
          render 'cp-business-copy', field: 'seo_title'
        endcapture
        capture page_description
          render 'cp-business-copy', field: 'description'
        endcapture
      endif
      assign title_site_suffix = ' – ' | append: shop.name
      assign title_with_site_len = page_title.size | plus: title_site_suffix.size
      assign page_title_downcase = page_title | downcase
      assign shop_name_downcase = shop.name | downcase
      assign title_should_append_shop = true
      if page_title_downcase contains shop_name_downcase
        assign title_should_append_shop = false
      elsif title_with_site_len > 60
        assign title_should_append_shop = false
      endif
    -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- if title_should_append_shop %} &ndash; {{ shop.name }}{% endif -%}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {% render 'meta-tags', page_title: page_title, page_description: page_description %}
    {% render 'cp-rich-results-breadcrumbs' %}
    {% render 'cp-review-aggregate-jsonld' %}

    <script type="importmap">
      {
        "imports": {
          "mdl-scrollsnap": "{{ 'scrollsnap.js' | asset_url }}",
          "timeline-component": "{{ 'timeline-component.js' | asset_url }}",
          "comparison-table-component": "{{ 'comparison-table-component.js' | asset_url }}",
          "dual-scroll-component": "{{ 'section-dual-scroll.js' | asset_url }}"
        }
      }
    </script>

    <script src="{{ 'vendor-v4.js' | asset_url | split: '?' | first }}" defer="defer" fetchpriority="low"></script>
    <script src="{{ 'pubsub.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'global.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'modules-basis.js' | asset_url }}" defer="defer"></script>

    {{ content_for_header }}

    {%- liquid
      render 'css-variables'
      echo 'base.css' | asset_url | stylesheet_tag: preload: true
      
      if text_direction == 'rtl'
        echo 'rtl.css' | asset_url | stylesheet_tag
      endif
    -%}

    <link rel="stylesheet" href="{{ 'apps.css' | asset_url }}" media="print" fetchpriority="low" onload="this.media='all'">
    {%- if request.page_type == 'index' or template.suffix == 'konfigurator-lagun' or template.suffix == 'lagun-seite-neu' -%}
      {{ 'cp-redesign.css' | asset_url | stylesheet_tag: preload: true }}
    {%- endif -%}

    {% # theme-check-disable %}
    {%- unless settings.type_body_font.system? -%}
      <link
        rel="preload"
        as="font"
        href="{{ settings.type_body_font | font_url }}"
        type="font/woff2"
        crossorigin
      >
    {%- endunless -%}
    {%- unless settings.type_header_font.system? -%}
      <link
        rel="preload"
        as="font"
        href="{{ settings.type_header_font | font_url }}"
        type="font/woff2"
        crossorigin
      >
    {%- endunless -%}
    {% # theme-check-enable %}
    
    {%- if settings.predictive_search_enabled -%}
      <link rel="stylesheet" href="{{ 'component-predictive-search.css' | asset_url }}" media="print" onload="this.media='all'">
    {%- endif -%}
    {%- if settings.quick_view_enabled -%}
      <link rel="stylesheet" href="{{ 'component-quick-view.css' | asset_url }}" media="print" onload="this.media='all'">
    {%- endif -%}
    {%- if settings.color_swatches_enabled -%}
      <link rel="stylesheet" href="{{ 'component-color-swatches.css' | asset_url }}" media="print" onload="this.media='all'">
    {%- endif -%}
    {%- if settings.glass_design_enabled -%}
      <link rel="stylesheet" href="{{ 'component-glass.css' | asset_url }}" media="print" onload="this.media='all'">
      <noscript>{{ 'component-glass.css' | asset_url | stylesheet_tag }}</noscript>
      <style>
        .glass-enabled {
          --glass-blur: {{ settings.glass_blur_intensity }}px;
          --glass-bg-opacity: {{ settings.glass_bg_opacity | divided_by: 100.0 }};
          --glass-border-opacity: {{ settings.glass_border_opacity | divided_by: 100.0 }};
          --glass-tint: {{ settings.glass_tint_color.red }}, {{ settings.glass_tint_color.green }}, {{ settings.glass_tint_color.blue }};
        }
      </style>
    {%- endif -%}
    {%- if linklists.gift-wrapping.links != blank and linklists.gift-wrapping.links.first.type == 'product_link' -%}
      <link rel="stylesheet" href="{{ 'component-gift-wrapping.css' | asset_url }}" media="print" onload="this.media='all'">
      <noscript>{{ 'component-gift-wrapping.css' | asset_url | stylesheet_tag }}</noscript>
    {%- endif -%}

    {%- render 'js-variables' -%}
        <!-- SlideRule Script Start -->
        {% include 'sliderule-data' %}
        <!-- SlideRule Script End -->
        {% comment %}cp-mietmanager-cache-bust-20260610{% endcomment %}
<!-- cp-mietmanager-html-cache-bust-20260610 -->
  {% comment %}cp588-google-ads-conversion-bridge-v20260707b{% endcomment %}
<script id="cp-ads-conversion-bridge-v20260707b">
  (function() {
    if (window.__cpAdsConversionBridgeVersion === '20260707b') return;
    window.__cpAdsConversionBridgeVersion = '20260707b';

    var ADS_ID = 'AW-398604311';
    var CONTACT_LABEL = 'VX4NCMeu2KkcEJfwiL4B';
    var BOOKING_LABEL = 'd9FMCI_dv6kcEJfwiL4B';
    var ANALYTICS_ENDPOINT = 'https://analytics.camping-pioneers.de/api/collect';
    var tracked = {};

    function dataLayer() {
      window.dataLayer = window.dataLayer || [];
      return window.dataLayer;
    }

    function ensureGtag() {
      dataLayer();
      if (typeof window.gtag !== 'function') {
        window.gtag = function() { dataLayer().push(arguments); };
      }
      if (!document.querySelector('script[data-cp-ads-conversion-bridge="true"]')) {
        var script = document.createElement('script');
        script.async = true;
        script.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(ADS_ID);
        script.setAttribute('data-cp-ads-conversion-bridge', 'true');
        (document.head || document.documentElement).appendChild(script);
      }
      if (!window.__cpAdsConversionBridgeConfigured) {
        window.__cpAdsConversionBridgeConfigured = true;
        window.gtag('js', new Date());
        window.gtag('config', ADS_ID, { send_page_view: false });
      }
    }

    function randomId(prefix) {
      if (window.crypto && window.crypto.randomUUID) return prefix + '_' + window.crypto.randomUUID();
      return prefix + '_' + Date.now() + '_' + Math.random().toString(36).slice(2);
    }

    function idFor(key, prefix) {
      try {
        var current = window.localStorage.getItem(key);
        if (current) return current;
        current = randomId(prefix);
        window.localStorage.setItem(key, current);
        return current;
      } catch (e) {
        return randomId(prefix);
      }
    }

    function once(key, ttlMs) {
      var now = Date.now();
      if (tracked[key] && now - tracked[key] < ttlMs) return false;
      tracked[key] = now;
      return true;
    }

    function conversion(label, category, details) {
      ensureGtag();
      var value = details && Number(details.value);
      var payload = {
        send_to: ADS_ID + '/' + label,
        event_category: category,
        event_label: details && details.eventLabel,
        event_id: details && details.eventId
      };
      if (Number.isFinite(value) && value > 0) {
        payload.value = value;
        payload.currency = 'EUR';
      }
      window.gtag('event', 'conversion', payload);
    }

    function analyticsUtm(url) {
      return {
        source: url.searchParams.get('utm_source') || undefined,
        medium: url.searchParams.get('utm_medium') || undefined,
        campaign: url.searchParams.get('utm_campaign') || undefined,
        term: url.searchParams.get('utm_term') || undefined,
        content: url.searchParams.get('utm_content') || undefined
      };
    }

    function sendAnalytics(name, property, extra) {
      try {
        var url = new URL(window.location.href);
        var journeyId = idFor('cp_mietmanager_journey_id', 'mmj');
        var sessionId = idFor('cp_mietmanager_session_id', 'mms');
        var body = JSON.stringify({ events: [{
          name: name,
          property: property,
          timestamp: new Date().toISOString(),
          pixelVersion: 'cp588-ads-bridge-20260707b',
          visitorId: journeyId,
          journeyId: journeyId,
          sessionId: sessionId,
          consent: { analytics: true },
          utm: analyticsUtm(url),
          page: { url: url.toString(), referrer: document.referrer || undefined, title: document.title || undefined },
          target: extra && extra.target,
          rental: extra && extra.rental,
          raw: extra && extra.raw
        }] });
        if (navigator.sendBeacon && navigator.sendBeacon(ANALYTICS_ENDPOINT, new Blob([body], { type: 'application/json' }))) return;
        fetch(ANALYTICS_ENDPOINT, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: body,
          keepalive: true,
          mode: 'cors'
        }).catch(function() {});
      } catch (e) {}
    }

    function pageContext() {
      var path = window.location.pathname || '';
      if (path.indexOf('/pages/dachzelte-mieten') === 0) return { formContext: 'dachzelt_contact', property: 'mietmanager', rentalKind: 'dachzelt' };
      if (path.indexOf('/pages/anhaenger-mieten') === 0) return { formContext: 'haenger_contact', property: 'mietmanager', rentalKind: 'haenger' };
      if (path.indexOf('/pages/contact') === 0 || path.indexOf('/en/pages/contact') === 0 || path.indexOf('/fr/pages/contact') === 0) return { formContext: 'regular_contact', property: 'shopify' };
      return null;
    }

    function isContactForm(form) {
      if (!form || form.tagName !== 'FORM') return false;
      var action = String(form.getAttribute('action') || '');
      var formType = form.querySelector('input[name="form_type"]');
      return Boolean((formType && formType.value === 'contact') || action.indexOf('/contact') !== -1);
    }

    function trackContact(form, trigger) {
      var context = pageContext();
      if (!context || !isContactForm(form)) return;
      var key = 'contact:' + context.formContext;
      if (!once(key, 2500)) return;
      var eventId = randomId('cp588_contact');
      var payload = {
        event: 'cp_contact_submit',
        conversionId: '398604311',
        conversionLabel: CONTACT_LABEL,
        conversionCategory: 'contact',
        eventId: eventId,
        formContext: context.formContext,
        rentalKind: context.rentalKind,
        pagePath: window.location.pathname,
        trigger: trigger
      };
      dataLayer().push(payload);
      conversion(CONTACT_LABEL, 'contact', { eventId: eventId, eventLabel: context.formContext });
      sendAnalytics('form_submitted', context.property, {
        target: { label: 'contact_submit_button', role: 'form_submit' },
        rental: context.rentalKind ? { rentalKind: context.rentalKind } : undefined,
        raw: payload
      });
    }

    function submitButtonFromEvent(evt) {
      if (!evt.target || !evt.target.closest) return null;
      var button = evt.target.closest('button, input[type="submit"]');
      if (!button) return null;
      if (button.tagName === 'BUTTON') {
        var type = (button.getAttribute('type') || 'submit').toLowerCase();
        if (type !== 'submit') return null;
      }
      return button;
    }

    document.addEventListener('click', function(evt) {
      var button = submitButtonFromEvent(evt);
      var form = button && (button.form || (button.closest ? button.closest('form') : null));
      trackContact(form, 'click');
    }, true);

    document.addEventListener('submit', function(evt) {
      trackContact(evt.target, 'submit');
    }, true);

    function rentalFromPayload(payload) {
      return {
        rentalKind: payload.rentalKind || undefined,
        productId: payload.productId || undefined,
        variantId: payload.variantId || undefined,
        locationId: payload.locationId || undefined,
        price: Number(payload.value || 0) || undefined,
        bookable: payload.event === 'cp_rental_booking_created' ? true : undefined
      };
    }

    function handleConversionPayload(payload) {
      if (!payload || typeof payload !== 'object') return;
      if (payload.event !== 'cp_rental_booking_created' && payload.event !== 'cp_rental_booking_step') return;
      var eventKey = payload.event + ':' + (payload.eventId || payload.variantId || '') + ':' + (payload.value || '');
      if (!once(eventKey, 2500)) return;
      if (payload.event === 'cp_rental_booking_created') {
        conversion(BOOKING_LABEL, 'rental_booking', {
          value: payload.value,
          eventId: payload.eventId || randomId('cp588_booking'),
          eventLabel: payload.rentalKind || 'rental_booking'
        });
        sendAnalytics('rental_booking_requested', 'mietmanager', { rental: rentalFromPayload(payload), raw: payload });
      } else {
        sendAnalytics('rental_availability_checked', 'mietmanager', { rental: rentalFromPayload(payload), raw: payload });
      }
    }

    function patchDataLayerPush() {
      var dl = dataLayer();
      if (dl.__cpAdsConversionBridgePatched) return;
      var originalPush = dl.push;
      dl.push = function() {
        for (var i = 0; i < arguments.length; i += 1) handleConversionPayload(arguments[i]);
        return originalPush.apply(dl, arguments);
      };
      dl.__cpAdsConversionBridgePatched = true;
      for (var j = 0; j < dl.length; j += 1) handleConversionPayload(dl[j]);
    }

    patchDataLayerPush();
    window.addEventListener('message', function(evt) {
      if (!evt.data || evt.data.type !== 'cp-mietmanager:conversion') return;
      handleConversionPayload(evt.data.payload || {});
    });
  })();
</script>

{% if request.locale.iso_code == 'en' %}
  {% if template.name == 'index' or template.suffix == 'konfigurator-lagun' or template.suffix == 'lagun-seite-neu' %}
    <script src="{{ 'cp-english-runtime.js' | asset_url }}" defer="defer"></script>
  {% endif %}
{% endif %}

</head>

  <body class="template-{{ request.page_type }}{% if request.page_type == 'index' or template.suffix == 'konfigurator-lagun' or template.suffix == 'lagun-seite-neu' %} cp-theme-redesign{% endif %}{% if request.page_type == 'product' and product.template_suffix == 'lagun-seite-neu' %} cp-lagun-redesign{% endif %}{% if request.design_mode %} shopify-design-mode{% endif %}{% if settings.glass_design_enabled %} glass-enabled{% endif %}"
    {%- if settings.image_zoom_effect_enabled %} data-animate-image{% endif -%}
    {%- if settings.image_loading_bar_enabled %} data-lazy-image{% endif -%}
    {%- if settings.heading_capitalize %} data-heading-capitalize{% endif -%}
    {%- if settings.heading_center %} data-heading-center{% endif -%}
    {%- if settings.price_superscript %} data-price-superscript{% endif -%}
    {%- if settings.button_corner_radius > 0 %} data-button-round{% endif -%}
  >
    <a class="skip-to-content-link button button--small visually-hidden" href="#MainContent">
      {{ "accessibility.skip_to_text" | t }}
    </a>

    {% render 'transition-cover' %}

    <div class="transition-body">
      {% sections 'header-group' %}

      <div class="transition-content">
        <main id="MainContent" class="content-for-layout focus-none shopify-section" role="main" tabindex="-1">
          {{ content_for_layout }}
        </main>

        {% sections 'footer-group' %}
      </div>
    </div>

    {% sections 'overlay-group' %}

    <ul hidden>
      <li id="a11y-refresh-page-message">{{ 'accessibility.refresh_page' | t }}</li>
    </ul>
    <svg xmlns="http://www.w3.org/2000/svg" class="hidden">
      <symbol id="icon-cart" fill="none" viewbox="0 0 18 19">
        <path d="M3.09333 5.87954L16.2853 5.87945V5.87945C16.3948 5.8795 16.4836 5.96831 16.4836 6.07785V11.4909C16.4836 11.974 16.1363 12.389 15.6603 12.4714C11.3279 13.2209 9.49656 13.2033 5.25251 13.9258C4.68216 14.0229 4.14294 13.6285 4.0774 13.0537C3.77443 10.3963 2.99795 3.58502 2.88887 2.62142C2.75288 1.42015 0.905376 1.51528 0.283581 1.51478" stroke="currentColor"/>
        <path d="M13.3143 16.8554C13.3143 17.6005 13.9183 18.2045 14.6634 18.2045C15.4085 18.2045 16.0125 17.6005 16.0125 16.8554C16.0125 16.1104 15.4085 15.5063 14.6634 15.5063C13.9183 15.5063 13.3143 16.1104 13.3143 16.8554Z" fill="currentColor"/>
        <path d="M3.72831 16.8554C3.72831 17.6005 4.33233 18.2045 5.07741 18.2045C5.8225 18.2045 6.42651 17.6005 6.42651 16.8554C6.42651 16.1104 5.8225 15.5063 5.07741 15.5063C4.33233 15.5063 3.72831 16.1104 3.72831 16.8554Z" fill="currentColor"/>
      </symbol>
    </svg>

    {%- if settings.image_loading_bar_enabled %}
      <script src="{{ 'lazyimage.js' | asset_url }}" defer></script>
    {% endif -%}
    {%- comment -%} predictive-search.js is lazy-loaded on first search interaction via the loader in sections/header.liquid. {%- endcomment -%}
    {%- if settings.quick_view_enabled -%}
      <script src="{{ 'quick-view.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}
    {%- if settings.color_swatches_enabled -%}
      <script src="{{ 'color-swatches.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}
    {%- if linklists.gift-wrapping.links != blank and linklists.gift-wrapping.links.first.type == 'product_link' -%}
      <script src="{{ 'gift-wrapping.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}
    
    {% render 'js-utilities' %}
    {% render 'cp-analytics-bridge' %}
    {%- if request.page_type == 'index' or template.suffix == 'konfigurator-lagun' or template.suffix == 'lagun-seite-neu' -%}
      <script src="{{ 'cp-redesign.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}
  {% render 'cp-b2b-price-preview' %}
</body>
</html>

{{ 'cp-lagun-configurator.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cp-english-runtime.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'cp-lagun-configurator.js' | asset_url }}" defer="defer"></script>
{%- liquid
  assign step_mount = section.blocks | where: 'type', 'step_mount' | first
  assign step_leg = section.blocks | where: 'type', 'step_leg' | first
  assign step_arm = section.blocks | where: 'type', 'step_arm' | first
  assign step_under = section.blocks | where: 'type', 'step_under' | first
  assign step_table = section.blocks | where: 'type', 'step_table' | first
  assign gap_guide = section.blocks | where: 'type', 'gap_guide' | first
  assign service_guide = section.blocks | where: 'type', 'service_guide' | first
  assign color_guide = section.blocks | where: 'type', 'color_guide' | first
  assign extension_guide = section.blocks | where: 'type', 'extension_guide' | first
  if section.settings.product_wall_standard != blank
    assign configured_handle = section.settings.product_wall_standard.handle | default: section.settings.product_wall_standard
    assign wall_standard = all_products[configured_handle]
  else
    assign wall_standard = all_products['lagun-befestigungsplatte']
  endif
  if section.settings.product_wall_standard_black != blank
    assign configured_handle = section.settings.product_wall_standard_black.handle | default: section.settings.product_wall_standard_black
    assign wall_standard_black = all_products[configured_handle]
  else
    assign wall_standard_black = all_products['lagun-befestigungsplatte-black-edition-2023']
  endif
  if section.settings.product_wall_smart != blank
    assign configured_handle = section.settings.product_wall_smart.handle | default: section.settings.product_wall_smart
    assign wall_smart = all_products[configured_handle]
  else
    assign wall_smart = all_products['lagun-smart-befestigungsplatte']
  endif
  if section.settings.product_wall_smart_black != blank
    assign configured_handle = section.settings.product_wall_smart_black.handle | default: section.settings.product_wall_smart_black
    assign wall_smart_black = all_products[configured_handle]
  else
    assign wall_smart_black = all_products['lagun-smart-befestigungsplatte-black-edition']
  endif
  if section.settings.product_floor != blank
    assign configured_handle = section.settings.product_floor.handle | default: section.settings.product_floor
    assign floor = all_products[configured_handle]
  else
    assign floor = all_products['lagun-bodenadapter-alternative-zur-wandmontage']
  endif
  if section.settings.product_legs != blank
    assign configured_handle = section.settings.product_legs.handle | default: section.settings.product_legs
    assign legs = all_products[configured_handle]
  else
    assign legs = all_products['lagun-tischbein-in-verschiedenen-langen']
  endif
  if section.settings.product_adjustable_leg != blank
    assign configured_handle = section.settings.product_adjustable_leg.handle | default: section.settings.product_adjustable_leg
    assign adjustable_leg = all_products[configured_handle]
  else
    assign adjustable_leg = all_products['lagun-tischbein-mit-extra-verstellhohe']
  endif
  if section.settings.product_arm_silver != blank
    assign configured_handle = section.settings.product_arm_silver.handle | default: section.settings.product_arm_silver
    assign arm_silver = all_products[configured_handle]
  else
    assign arm_silver = all_products['lagun-arm-silber-400mm']
  endif
  if section.settings.product_arm_black != blank
    assign configured_handle = section.settings.product_arm_black.handle | default: section.settings.product_arm_black
    assign arm_black = all_products[configured_handle]
  else
    assign arm_black = all_products['lagun-arm-400mm-schwarz-black-edition-2023']
  endif
  if section.settings.product_extra_arm != blank
    assign configured_handle = section.settings.product_extra_arm.handle | default: section.settings.product_extra_arm
    assign extra_arm = all_products[configured_handle]
  else
    assign extra_arm = all_products['bundle-arm-bolzen-schwarz-400-mm']
  endif
  if section.settings.product_extra_arm_silver != blank
    assign configured_handle = section.settings.product_extra_arm_silver.handle | default: section.settings.product_extra_arm_silver
    assign extra_arm_silver = all_products[configured_handle]
  else
    assign extra_arm_silver = all_products['bundle-arm-300-mm-bolzen-verbindungsstuck-silber']
  endif
  if section.settings.product_extension_bolt != blank
    assign configured_handle = section.settings.product_extension_bolt.handle | default: section.settings.product_extension_bolt
    assign extension_bolt = all_products[configured_handle]
  else
    assign extension_bolt = all_products['lagun-tisch-erweiterungsbolzen-zum-verbinden-zweier-arme']
  endif
  if section.settings.product_under_table != blank
    assign configured_handle = section.settings.product_under_table.handle | default: section.settings.product_under_table
    assign under_table = all_products[configured_handle]
  else
    assign under_table = all_products['lagun-untertisch-befestigungsplatte-ersatzteil']
  endif
  if section.settings.product_folding_under_table != blank
    assign configured_handle = section.settings.product_folding_under_table.handle | default: section.settings.product_folding_under_table
    assign folding_under_table = all_products[configured_handle]
  else
    assign folding_under_table = all_products['lagun-untertisch-befestigungsplatte-mit-dreh-klappachse']
  endif
  if section.settings.product_gap != blank
    assign configured_handle = section.settings.product_gap.handle | default: section.settings.product_gap
    assign gap = all_products[configured_handle]
  else
    assign gap = all_products['lagun-gap-abstandshalter-fur-die-befestigungsplatte']
  endif
  if section.settings.product_compact_gap != blank
    assign configured_handle = section.settings.product_compact_gap.handle | default: section.settings.product_compact_gap
    assign compact_gap = all_products[configured_handle]
  else
    assign compact_gap = all_products['lagun-erweiterungsbugel-klein']
  endif
  if section.settings.product_table_top != blank
    assign configured_handle = section.settings.product_table_top.handle | default: section.settings.product_table_top
    assign table_top = all_products[configured_handle]
  else
    assign table_top = all_products['b-ware-tischplatten-fur-das-lagun-tischgestell-beton-fichte-eiche-500x700-mm-copy']
  endif
  if section.settings.product_adjustment_service != blank
    assign configured_handle = section.settings.product_adjustment_service.handle | default: section.settings.product_adjustment_service
    assign adjustment_service = all_products[configured_handle]
  else
    assign adjustment_service = all_products['anpassungsservice-fur-lagun-bein-oder-lagun-arm']
  endif
  if section.settings.product_silver_set != blank
    assign configured_handle = section.settings.product_silver_set.handle | default: section.settings.product_silver_set
    assign silver_set = all_products[configured_handle]
  else
    assign silver_set = all_products['lagun-tischgestell-set-mit-standard-befestigungsplatte-silber']
  endif
  if section.settings.product_black_set != blank
    assign configured_handle = section.settings.product_black_set.handle | default: section.settings.product_black_set
    assign black_set = all_products[configured_handle]
  else
    assign black_set = all_products['lagun-tischgestell-set-mit-standard-befestigungsplatte-schwarz']
  endif
  assign tops_collection = section.settings.tops_collection | default: collections['tischplatten-ohne-b-ware']
  assign poplar_top = tops_collection.products | where: 'handle', 'tischplatte-pappelholz-fur-lagun-tischgestell' | first
  assign ponga_top = tops_collection.products | where: 'handle', 'ponga-tischplatte-eiche-pappelsperrholz-mit-eichenoptik-einfach-beschichtet-inklusive-kanten-500-x-700-mm' | first
-%}
<section class="cp-lagun-configurator" id="cp-lagun-configurator-{{ section.id }}" data-cp-lagun-configurator data-cp-lagun-configurator-version="redesign-v1" data-currency="{{ cart.currency.iso_code | default: shop.currency }}" data-section-id="{{ section.id }}">
  <script type="application/json" data-cp-lagun-catalog>
    {
      "wallStandard": {{ wall_standard | json }}, "wallStandardBlack": {{ wall_standard_black | json }},
      "wallSmart": {{ wall_smart | json }}, "wallSmartBlack": {{ wall_smart_black | json }},
      "floor": {{ floor | json }}, "legs": {{ legs | json }}, "adjustableLeg": {{ adjustable_leg | json }},
      "armSilver": {{ arm_silver | json }}, "armBlack": {{ arm_black | json }}, "extraArm": {{ extra_arm | json }}, "extraArmSilver": {{ extra_arm_silver | json }}, "extensionBolt": {{ extension_bolt | json }},
      "underTable": {{ under_table | json }}, "foldingUnderTable": {{ folding_under_table | json }},
      "gap": {{ gap | json }}, "compactGap": {{ compact_gap | json }}, "tableTop": {{ table_top | json }},
      "poplarTop": {{ poplar_top | json }}, "pongaTop": {{ ponga_top | json }},
      "adjustmentService": {{ adjustment_service | json }}, "sets": [{{ silver_set | json }}, {{ black_set | json }}]
    }
  </script>
  <script type="application/json" data-cp-lagun-variant-gids>
    {
      "mount.standard.silver": "gid://shopify/ProductVariant/48833550745927",
      "mount.standard.black": "gid://shopify/ProductVariant/48825730171207",
      "mount.smart.silver": "gid://shopify/ProductVariant/48831442190663",
      "mount.smart.black": "gid://shopify/ProductVariant/48865492271431",
      "mount.flush.silver": "gid://shopify/ProductVariant/51266402517319",
      "mount.flush.black": "gid://shopify/ProductVariant/54035789218119",
      "mount.surface.silver": "gid://shopify/ProductVariant/51266402550087",
      "mount.surface.black": "gid://shopify/ProductVariant/54035789250887",
      "leg.400.silver": "gid://shopify/ProductVariant/48767238144327",
      "leg.500.silver": "gid://shopify/ProductVariant/48767238111559",
      "leg.500.black": "gid://shopify/ProductVariant/52886410920263",
      "leg.700.silver": "gid://shopify/ProductVariant/48767238078791",
      "leg.700.black": "gid://shopify/ProductVariant/52886410887495",
      "leg.500plus.silver": "gid://shopify/ProductVariant/49423994650951",
      "arm.400.silver": "gid://shopify/ProductVariant/53586840191303",
      "arm.400.black": "gid://shopify/ProductVariant/52886354133319",
      "under.standard.silver": "gid://shopify/ProductVariant/50082689614151",
      "under.standard.black": "gid://shopify/ProductVariant/50082689679687",
      "under.fold.silver": "gid://shopify/ProductVariant/52782662811975",
      "under.fold.black": "gid://shopify/ProductVariant/52782662844743",
      "gap.standard.silver": "gid://shopify/ProductVariant/49714257527111",
      "gap.standard.black": "gid://shopify/ProductVariant/49714257559879",
      "gap.smart.silver": "gid://shopify/ProductVariant/51311722266951",
      "gap.smart.black": "gid://shopify/ProductVariant/51311722299719",
      "extension.300.silver": "gid://shopify/ProductVariant/53599015403847",
      "extension.300.black": "gid://shopify/ProductVariant/54388728889671",
      "extension.400.arm.silver": "gid://shopify/ProductVariant/53586840191303",
      "extension.400.arm.black": "gid://shopify/ProductVariant/52886354133319",
      "extension.400.bolt.silver": "gid://shopify/ProductVariant/52886288630087",
      "extension.400.bolt.black": "gid://shopify/ProductVariant/52886288662855",
      "table.oakModern": "gid://shopify/ProductVariant/51443081969991",
      "table.pine": "gid://shopify/ProductVariant/51443081937223",
      "table.concrete": "gid://shopify/ProductVariant/51443082035527",
      "table.oakLight": "gid://shopify/ProductVariant/51443082002759",
      "table.poplar": "gid://shopify/ProductVariant/48831380259143",
      "table.ponga": "gid://shopify/ProductVariant/48830648451399",
      "service.default": "gid://shopify/ProductVariant/48830437196103",
      "legacy.arm.400.silver": "gid://shopify/ProductVariant/49479811072327"
    }
  </script>
  <script type="application/json" data-cp-purchase-clusters>{% render 'cp-lagun-purchase-clusters' %}</script>
  <script type="application/json" data-cp-initial-cart>{"items":[{% for item in cart.items %}{% render 'cp-lagun-cart-item', item: item %}{% unless forloop.last %},{% endunless %}{% endfor %}]}</script>
  <script type="application/json" data-cp-delivery>{
    {%- assign delivery_separator = '' -%}
    {%- assign delivery_products = 'wallStandard,wallStandardBlack,wallSmart,wallSmartBlack,floor,legs,adjustableLeg,armSilver,armBlack,extraArm,extraArmSilver,extensionBolt,underTable,foldingUnderTable,gap,compactGap,tableTop' | split: ',' -%}
    {%- for delivery_key in delivery_products -%}
      {%- case delivery_key -%}
        {%- when 'wallStandard' -%}{%- assign delivery_product = wall_standard -%}
        {%- when 'wallStandardBlack' -%}{%- assign delivery_product = wall_standard_black -%}
        {%- when 'wallSmart' -%}{%- assign delivery_product = wall_smart -%}
        {%- when 'wallSmartBlack' -%}{%- assign delivery_product = wall_smart_black -%}
        {%- when 'floor' -%}{%- assign delivery_product = floor -%}
        {%- when 'legs' -%}{%- assign delivery_product = legs -%}
        {%- when 'adjustableLeg' -%}{%- assign delivery_product = adjustable_leg -%}
        {%- when 'armSilver' -%}{%- assign delivery_product = arm_silver -%}
        {%- when 'armBlack' -%}{%- assign delivery_product = arm_black -%}
        {%- when 'extraArm' -%}{%- assign delivery_product = extra_arm -%}
        {%- when 'extraArmSilver' -%}{%- assign delivery_product = extra_arm_silver -%}
        {%- when 'extensionBolt' -%}{%- assign delivery_product = extension_bolt -%}
        {%- when 'underTable' -%}{%- assign delivery_product = under_table -%}
        {%- when 'foldingUnderTable' -%}{%- assign delivery_product = folding_under_table -%}
        {%- when 'gap' -%}{%- assign delivery_product = gap -%}
        {%- when 'compactGap' -%}{%- assign delivery_product = compact_gap -%}
        {%- when 'tableTop' -%}{%- assign delivery_product = table_top -%}
      {%- endcase -%}
      {%- for delivery_variant in delivery_product.variants -%}
        {{ delivery_separator }}"{{ delivery_variant.id }}": {"preorder": {{ delivery_variant.metafields.custom.preorder_enabled.value | default: false | json }}, "date": {{ delivery_variant.metafields.custom.preorder_delivery_date.value | json }}}{%- assign delivery_separator = ',' -%}
      {%- endfor -%}
    {%- endfor -%}
  }</script>

  <div class="page-width cp-lagun-configurator__shell">
    <header class="cp-lagun-configurator__hero">
      <div class="cp-lagun-hero__copy">
        <p class="cp-lagun-kicker">{{ section.settings.kicker | escape }}</p>
        <h1>{{ section.settings.heading }}</h1>
        <p>{{ section.settings.intro | default: 'Frühstücken, am Laptop arbeiten oder Platz zum Einsteigen schaffen: Stell dir den Tisch zusammen, der zu deinem Sitzplatz und deinem Alltag im Camper passt.' | escape }}</p>
        <a class="cp-lagun-configurator__start" href="#cp-lagun-color">Dein Lagun zusammenstellen <span aria-hidden="true">↗</span></a>
        <span class="cp-lagun-hero__footnote">Wir führen dich durch 4 Bauteile – Schritt für Schritt.</span>
      </div>
      <div class="cp-lagun-hero__image">
        {%- assign lifestyle_image = section.settings.hero_image | default: silver_set.images[6] -%}
        {%- if lifestyle_image -%}{{ lifestyle_image | image_url: width: 1400 | image_tag: widths: '600, 900, 1400', sizes: '(min-width: 990px) 50vw, 100vw', loading: 'eager', fetchpriority: 'high', alt: 'Lagun Tischgestell im Camper: mehr Freiraum zum Leben' }}{%- endif -%}
        <span>Mehr Platz für deinen Alltag.</span>
      </div>
    </header>

    <details class="cp-lagun-save-panel">
      <summary><span>Dein Ausbau braucht etwas Bedenkzeit?</span><strong>Konfiguration speichern &amp; teilen <span aria-hidden="true">＋</span></strong></summary>
      <div class="cp-lagun-save-panel__body">
        <p>Merke dir deinen Zwischenstand, besprich ihn mit deiner Reisebegleitung oder lade eine gespeicherte Auswahl. Preise und Verfügbarkeit prüfen wir beim Laden neu.</p>
        <div class="cp-lagun-save-actions">
          <button type="button" data-cp-config-action="save">Auf diesem Gerät speichern</button>
          <button type="button" data-cp-config-action="share">Link teilen ↗</button>
          <button type="button" data-cp-config-action="download">Datei herunterladen ↓</button>
          <button type="button" data-cp-config-action="upload">Konfiguration hochladen ↑</button>
          <button type="button" data-cp-config-action="restore" hidden>Gespeicherte Auswahl laden</button>
        </div>
        <input type="file" accept=".json,application/json" data-cp-config-file aria-label="Lagun-Konfiguration als JSON-Datei auswählen" hidden>
        <label class="cp-lagun-share-result" data-cp-share-result hidden>Dein Link zum Weitergeben<input type="text" readonly data-cp-share-link></label>
        <p class="cp-lagun-save-panel__note">Dateien enthalten auch deine Anpassungswünsche. Im geteilten Link lassen wir deine Freitextangaben weg.</p>
        <p role="status" data-cp-config-status></p>
      </div>
    </details>

    <div class="cp-lagun-configurator__layout">
      <div class="cp-lagun-configurator__steps">
        <section class="cp-lagun-configurator__color" id="cp-lagun-color" {{ color_guide.shopify_attributes }}>
          <div class="cp-lagun-heading-row"><p class="cp-lagun-kicker">ZUERST DER LOOK</p></div>
          <h2>{{ color_guide.settings.title | escape }}</h2>
          <p>{{ color_guide.settings.intro | escape }}</p>
          <div class="cp-config-color-options" role="group" aria-label="Farbe auswählen">
            <button type="button" class="cp-config-color-option" data-cp-color="silver" aria-pressed="false">
              <span class="cp-config-color-option__image">{{ silver_set.featured_image | image_url: width: 700 | image_tag: widths: '350, 500, 700', sizes: '(min-width: 990px) 350px, 45vw', loading: 'eager', alt: 'Lagun Standardgestell in Silber' }}</span>
              <span class="cp-config-color-option__body"><span class="cp-lagun-swatch cp-lagun-swatch--silver"></span><strong>Silber</strong><span class="cp-config-color-option__check" aria-hidden="true">✓</span><small>{{ color_guide.settings.silver | escape }}</small></span>
            </button>
            <button type="button" class="cp-config-color-option" data-cp-color="black" aria-pressed="false">
              <span class="cp-config-color-option__image">{{ black_set.featured_image | image_url: width: 700 | image_tag: widths: '350, 500, 700', sizes: '(min-width: 990px) 350px, 45vw', loading: 'eager', alt: 'Lagun Standardgestell in Schwarz' }}</span>
              <span class="cp-config-color-option__body"><span class="cp-lagun-swatch cp-lagun-swatch--black"></span><strong>Schwarz</strong><span class="cp-config-color-option__check" aria-hidden="true">✓</span><small>{{ color_guide.settings.black | escape }}</small></span>
            </button>
          </div>
          <p class="cp-lagun-configurator__color-note" data-cp-color-note>Die Bauteile unten zeigen zunächst Silber. Entscheide dich jetzt oder vergleiche später.</p>
        </section>

        <nav class="cp-lagun-step-nav" aria-label="Konfigurationsschritte">
          <a href="#cp-lagun-step-mount">01 Befestigung</a><a href="#cp-lagun-step-leg">02 Bein</a><a href="#cp-lagun-step-arm">03 Arm</a><a href="#cp-lagun-step-under">04 Untertischplatte</a><a href="#cp-lagun-step-table">05 Tischplatte</a><a href="#cp-lagun-step-service">06 Anpassung</a>
        </nav>

        <section class="cp-lagun-step" id="cp-lagun-step-mount" data-cp-step="mount" {{ step_mount.shopify_attributes }}>
          <div class="cp-lagun-step__heading"><span class="cp-lagun-step__number">01</span><div><p>{{ step_mount.settings.kicker | escape }}</p><h2>{{ step_mount.settings.title | escape }}</h2></div></div>
          <p class="cp-lagun-step__intro">{{ step_mount.settings.intro | escape }}</p>
          <div class="cp-lagun-choice-grid" role="group" aria-label="Montageort">
            {% render 'cp-lagun-config-option', choice: 'mount', value: 'wall', card_product: wall_standard, title: 'An der Wand', description: 'Du möchtest deine Tischhöhe anpassen und den Boden frei halten? Nutze eine tragfähige Möbelwand neben deinem Sitzplatz.', facts: 'Standard- oder schmale Smart-Platte', tag: 'Der Klassiker' %}
            {% render 'cp-lagun-config-option', choice: 'mount', value: 'floor', card_product: floor, title: 'Auf dem Boden', description: 'Neben deinem Sitzplatz fehlt eine geeignete Wand? Befestige dein Lagun auf einer tragfähigen Bodenfläche.', facts: 'Bündig oder aufgesetzt' %}
          </div>
          <div class="cp-lagun-followup" data-cp-followup="wall" hidden>
            <h3>Wie viel Platz hast du an der Wand?</h3>
            <div class="cp-lagun-choice-grid" role="group" aria-label="Wandplatte">
              {% render 'cp-lagun-config-option', choice: 'mountVariant', value: 'standard', card_product: wall_standard, title: 'Standard-Platte', description: 'Für dich, wenn genug Wandfläche frei ist: Die breite Platte verteilt die Kraft auf eine größere Fläche.', facts: '170 × 91 mm · 13 mm stark' %}
              {% render 'cp-lagun-config-option', choice: 'mountVariant', value: 'smart', card_product: wall_smart, title: 'Smart-Platte', description: 'Für dich, wenn nur ein schmaler, stabiler Montageplatz frei ist. Die Platte bleibt hinter dem Bein besonders unauffällig.', facts: '170 × 30 mm · 13 mm stark' %}
            </div>
            <div class="cp-lagun-advice">{{ step_mount.settings.advice_0 }}</div>
            <div class="cp-lagun-gap-guide" {{ gap_guide.shopify_attributes }}>
              <div class="cp-lagun-gap-guide__photo">
                {% assign gap_photo = gap_guide.settings.image | default: gap.images[2] %}
                {{ gap_photo | image_url: width: 700 | image_tag: widths: '350, 500, 700', loading: 'lazy', alt: 'GAP hinter der Befestigungsplatte; das Bein sitzt auf der Schwalbenschwanzführung' }}
                <span>Mehr Abstand zur Wand.<br><strong>Mehr Platz zum Schwenken.</strong></span>
              </div>
              <div class="cp-lagun-gap-guide__copy"><p class="cp-lagun-kicker">BRAUCHE ICH EINEN GAP?</p><h3>{{ gap_guide.settings.title | escape }}</h3>{{ gap_guide.settings.text }}<p class="cp-lagun-gap-guide__tip">{{ gap_guide.settings.tip | escape }}</p></div>
              <details class="cp-lagun-gap-install"><summary>Wie werden GAP, Platte und Bein verbunden?</summary><div class="cp-lagun-gap-install__body">{% assign frame_photo = gap_guide.settings.frame_image | default: gap.images[3] %}{{ frame_photo | image_url: width: 500 | image_tag: loading: 'lazy', alt: 'Offener GAP-Rahmen vor der Montage der Befestigungsplatte' }}<div>{{ gap_guide.settings.installation }}</div></div></details>
              <div class="cp-lagun-gap-guide__selection"><img data-cp-gap-image src="{{ gap.featured_image | image_url: width: 220 }}" width="110" height="110" alt="Lagun GAP Abstandshalter" loading="lazy"><label class="cp-lagun-check"><input type="checkbox" data-cp-choice="gap"><span><strong>Passenden GAP ergänzen</strong><small data-cp-gap-label>Standard zur Standard-Platte · GAP klein zur Smart-Platte</small><b data-cp-gap-price></b></span></label></div>
            </div>
          </div>
          <div class="cp-lagun-followup" data-cp-followup="floor" hidden>
            <h3>Lieber bündig oder aufgesetzt?</h3>
            <div class="cp-lagun-choice-grid" role="group" aria-label="Bodenadapter">
              {% render 'cp-lagun-config-option', choice: 'mountVariant', value: 'flush', card_product: floor, title: 'Flush · bündig', description: 'Du möchtest nach dem Abnehmen des Gestells möglichst wenig Überstand? Dieser Adapter wird bündig eingelassen.', facts: 'Bodenausschnitt erforderlich' %}
              {% render 'cp-lagun-config-option', choice: 'mountVariant', value: 'surface', card_product: floor, title: 'Aufgesetzt', description: 'Du möchtest keinen großen Ausschnitt im Boden? Dieser Adapter wird oben aufgeschraubt und bleibt etwas erhöht.', facts: 'Ohne Bodenausschnitt' %}
            </div>
            <p class="cp-lagun-alert"><strong>Gut zu wissen:</strong> Bei Bodenmontage entfällt die Höhenverstellung. Passende Schrauben für deinen tragfähigen Bodenaufbau besorgst du separat.</p>
          </div>
          <details><summary>{{ step_mount.settings.faq_0_title | escape }}</summary>{{ step_mount.settings.faq_0_text }}</details>
          <details class="cp-lagun-original"><summary data-cp-product-info-title="mount">Weitere Produktdetails</summary><div data-cp-product-description="mount"></div><a data-cp-product-link="mount" target="_blank" rel="noopener">Produktseite mit allen Bildern öffnen ↗</a></details>
        </section>

        <section class="cp-lagun-step" id="cp-lagun-step-leg" data-cp-step="leg" {{ step_leg.shopify_attributes }}>
          <div class="cp-lagun-step__heading"><span class="cp-lagun-step__number">02</span><div><p>{{ step_leg.settings.kicker | escape }}</p><h2>{{ step_leg.settings.title | escape }}</h2></div></div>
          <p class="cp-lagun-step__intro">{{ step_leg.settings.intro | escape }}</p>
          <div class="cp-lagun-choice-grid" role="group" aria-label="Tischbein">
            {% render 'cp-lagun-config-option', choice: 'leg', value: '400', card_product: legs, title: '400 mm', description: 'Dein Montagepunkt liegt höher oder dein Sitzplatz ist niedrig? Prüfe zuerst diese kurze Ausführung.', facts: 'Bis zu 15 cm Verstellbereich an der Wand' %}
            {% render 'cp-lagun-config-option', choice: 'leg', value: '500', card_product: legs, title: '500 mm', description: 'Dein Ausgangspunkt für viele Sitzgruppen. Gleiche die Länge vor der Wahl mit deinem Montagepunkt ab.', facts: 'Bis zu 15 cm Verstellbereich an der Wand', tag: 'Allrounder' %}
            {% render 'cp-lagun-config-option', choice: 'leg', value: '500plus', card_product: adjustable_leg, title: '500 mm · zwei Griffe', description: 'Du wechselst zwischen Sitzplätzen oder brauchst deutlich unterschiedliche Tischhöhen? Die zwei Griffe geben dir mehr Verstellweg.', facts: 'Bis zu 30 cm Verstellbereich an der Wand' %}
            {% render 'cp-lagun-config-option', choice: 'leg', value: '700', card_product: legs, title: '700 mm', description: 'Deine Befestigung sitzt weit unten oder deine Sitzbank ist hoch? Das längere Bein überbrückt den größeren Abstand.', facts: 'Bis zu 15 cm Verstellbereich an der Wand' %}
          </div>
          <div class="cp-lagun-advice cp-lagun-advice--measure">{{ step_leg.settings.advice_0 }}</div>
          <details class="cp-lagun-original"><summary data-cp-product-info-title="leg">Weitere Produktdetails</summary><div data-cp-product-description="leg"></div><a data-cp-product-link="leg" target="_blank" rel="noopener">Produktseite mit allen Bildern öffnen ↗</a></details>
        </section>

        <section class="cp-lagun-step" id="cp-lagun-step-arm" data-cp-step="arm" {{ step_arm.shopify_attributes }}>
          <div class="cp-lagun-step__heading"><span class="cp-lagun-step__number">03</span><div><p>{{ step_arm.settings.kicker | escape }}</p><h2>{{ step_arm.settings.title | escape }}</h2></div></div>
          <p class="cp-lagun-step__intro">{{ step_arm.settings.intro | escape }}</p>
          <div class="cp-lagun-arm-guide" {{ extension_guide.shopify_attributes }}>
            <p class="cp-lagun-arm-guide__intro">{{ extension_guide.settings.intro | escape }}</p>
            <div class="cp-lagun-choice-grid cp-lagun-choice-grid--arm" role="radiogroup" aria-label="Tischarm und Armverlängerung">
              <label class="cp-lagun-choice cp-lagun-arm-choice" data-cp-arm-configuration-option="base">
                <input class="visually-hidden" type="radio" name="cp-lagun-arm-configuration-{{ section.id }}" value="base" data-cp-arm-configuration>
                <span class="cp-lagun-choice__image"><img data-cp-arm-configuration-image="base" src="{{ arm_silver.featured_image | image_url: width: 640 }}" width="320" height="230" alt="Lagun 400-mm-Basisarm" loading="lazy"><i class="cp-lagun-choice__tick" aria-hidden="true">✓</i></span>
                <span class="cp-lagun-choice__body"><strong>Nur 400-mm-Basisarm</strong><span class="cp-lagun-choice__description">Ein Schwenkarm für den normalen Sitzplatz – ohne zusätzliche Armverlängerung.</span><span class="cp-lagun-choice__facts">400 mm · um 360° drehbar</span><span class="cp-lagun-choice__bottom"><b data-cp-arm-configuration-price="base"></b><small data-cp-arm-configuration-stock="base"></small></span></span>
              </label>
              <label class="cp-lagun-choice cp-lagun-arm-choice" data-cp-arm-configuration-option="300">
                <input class="visually-hidden" type="radio" name="cp-lagun-arm-configuration-{{ section.id }}" value="300" data-cp-arm-configuration>
                <span class="cp-lagun-choice__image"><img data-cp-arm-configuration-image="300" src="{{ extra_arm_silver.featured_image | image_url: width: 640 }}" width="320" height="230" alt="Lagun zusätzlicher 300-mm-Arm mit Verbindungsbolzen" loading="lazy"><i class="cp-lagun-choice__tick" aria-hidden="true">✓</i></span>
                <span class="cp-lagun-choice__body"><span class="cp-lagun-choice__tag">Empfohlen</span><strong>Zusätzlicher 300-mm-Arm</strong><span class="cp-lagun-choice__description">Mehr Bewegungsfreiheit bei moderaterer Hebelwirkung. Der farblich passende Verbindungsbolzen ist enthalten.</span><span class="cp-lagun-choice__facts">Zweiter Schwenkarm · zweiter Drehpunkt</span><span class="cp-lagun-choice__bottom"><b data-cp-arm-configuration-price="300"></b><small data-cp-arm-configuration-stock="300"></small></span></span>
              </label>
              <label class="cp-lagun-choice cp-lagun-arm-choice" data-cp-arm-configuration-option="400">
                <input class="visually-hidden" type="radio" name="cp-lagun-arm-configuration-{{ section.id }}" value="400" data-cp-arm-configuration>
                <span class="cp-lagun-choice__image"><img data-cp-arm-configuration-image="400" src="{{ arm_silver.featured_image | image_url: width: 640 }}" width="320" height="230" alt="Lagun zusätzlicher 400-mm-Arm mit Verbindungsbolzen" loading="lazy"><i class="cp-lagun-choice__tick" aria-hidden="true">✓</i></span>
                <span class="cp-lagun-choice__body"><span class="cp-lagun-choice__tag cp-lagun-choice__tag--warning">Nur bei notwendiger Reichweite</span><strong>Zusätzlicher 400-mm-Arm</strong><span class="cp-lagun-choice__description">Erheblich größere Hebelwirkung und deutlich geringere Tragkraft. Nur mit einer kleinen, leichten Tischplatte verwenden.</span><span class="cp-lagun-choice__facts">Zweiter Schwenkarm · farblich passender Bolzen</span><span class="cp-lagun-choice__bottom"><b data-cp-arm-configuration-price="400"></b><small data-cp-arm-configuration-stock="400"></small></span></span>
              </label>
            </div>
            <p class="cp-lagun-arm-guide__advice">{{ extension_guide.settings.advice | escape }}</p>
          </div>
          <details><summary>{{ step_arm.settings.faq_0_title | escape }}</summary>{{ step_arm.settings.faq_0_text }}</details>
          <details class="cp-lagun-original"><summary data-cp-product-info-title="arm">Weitere Produktdetails</summary><div data-cp-product-description="arm"></div><a data-cp-product-link="arm" target="_blank" rel="noopener">Produktseite mit allen Bildern öffnen ↗</a></details>
        </section>

        <section class="cp-lagun-step" id="cp-lagun-step-under" data-cp-step="under" {{ step_under.shopify_attributes }}>
          <div class="cp-lagun-step__heading"><span class="cp-lagun-step__number">04</span><div><p>{{ step_under.settings.kicker | escape }}</p><h2>{{ step_under.settings.title | escape }}</h2></div></div>
          <p class="cp-lagun-step__intro">{{ step_under.settings.intro | escape }}</p>
          <div class="cp-lagun-choice-grid" role="group" aria-label="Untertischplatte">
            {% render 'cp-lagun-config-option', choice: 'under', value: 'standard', card_product: under_table, title: 'Standard', description: 'Dir reicht es, den Tisch zur Seite zu schwenken? Dann ist diese einfache Verbindung ohne Klappmechanik passend.', facts: 'Drehbar · ohne Klappscharnier' %}
            {% render 'cp-lagun-config-option', choice: 'under', value: 'fold', card_product: folding_under_table, title: 'Dreh- & Klappachse', description: 'Du möchtest häufiger vorbeigehen, ohne den Tisch abzunehmen? Klappe die Platte um 90° zur Seite und schaffe Platz.', facts: '200 × 200 mm · um 90° klappbar', tag: 'Mehr Freiraum' %}
          </div>
          <div class="cp-lagun-advice">{{ step_under.settings.advice_0 }}</div>
          <details class="cp-lagun-original"><summary data-cp-product-info-title="under">Weitere Produktdetails</summary><div data-cp-product-description="under"></div><a data-cp-product-link="under" target="_blank" rel="noopener">Produktseite mit allen Bildern öffnen ↗</a></details>
        </section>

        <section class="cp-lagun-step" id="cp-lagun-step-table" data-cp-step="table" {{ step_table.shopify_attributes }}>
          <div class="cp-lagun-step__heading"><span class="cp-lagun-step__number">05</span><div><p>{{ step_table.settings.kicker | escape }}</p><h2>{{ step_table.settings.title | escape }}</h2></div></div>
          <p class="cp-lagun-step__intro">{{ step_table.settings.intro | escape }}</p>
          <button type="button" class="cp-lagun-choice cp-lagun-choice--own" data-cp-choice="table" data-value="own" aria-pressed="false"><strong>Ich verwende meine eigene Tischplatte</strong><span>Keine zusätzliche Platte ergänzen <span aria-hidden="true">↗</span></span></button>
          <div class="cp-lagun-choice-grid" role="group" aria-label="Tischplatte">
            {% render 'cp-lagun-config-option', choice: 'table', value: 'oakModern', card_product: table_top, title: 'Eiche modern', description: 'Warmer Holzlook für einen gemütlichen Ausbau.', facts: '700 × 500 mm · 15 mm · unter 3 kg' %}
            {% render 'cp-lagun-config-option', choice: 'table', value: 'pine', card_product: table_top, title: 'Fichte / Kiefer', description: 'Helle Holzoptik, die Leichtigkeit in den Camper bringt.', facts: '700 × 500 mm · 15 mm · unter 3 kg' %}
            {% render 'cp-lagun-config-option', choice: 'table', value: 'concrete', card_product: table_top, title: 'Betonoptik', description: 'Klar und modern – besonders schön mit dunklen Details.', facts: '700 × 500 mm · 15 mm · unter 3 kg' %}
            {% render 'cp-lagun-config-option', choice: 'table', value: 'oakLight', card_product: table_top, title: 'Eiche hell', description: 'Eine helle Oberfläche für ein freundliches Raumgefühl.', facts: '700 × 500 mm · 15 mm · unter 3 kg' %}
            {% if poplar_top != blank %}{% render 'cp-lagun-config-option', choice: 'table', value: 'poplar', card_product: poplar_top, title: 'Pappelholz · Weiß', description: 'Die leichte Basis mit robuster, pflegeleichter HPL-Oberfläche.', facts: '700 × 500 mm · ca. 2,4 kg' %}{% endif %}
            {% if ponga_top != blank %}{% render 'cp-lagun-config-option', choice: 'table', value: 'ponga', card_product: ponga_top, title: 'Ponga · Eiche', description: 'Ausdrucksstarke Maserung und beschichtete Kanten. Bereits vorgebohrt.', facts: '700 × 500 mm · ca. 2,8 kg' %}{% endif %}
          </div>
          <details><summary>{{ step_table.settings.faq_0_title | escape }}</summary>{{ step_table.settings.faq_0_text }}</details>
          <details><summary>{{ step_table.settings.faq_1_title | escape }}</summary>{{ step_table.settings.faq_1_text }}</details>
          <a class="cp-lagun-service" href="#cp-lagun-step-service"><span><small>GRIFF IM WEG ODER SONDERMASS?</small><strong>Dein Lagun passend machen.</strong><span>Griffe umsetzen oder Bein kürzen: Deine Wünsche gibst du im nächsten Schritt direkt an.</span></span><b aria-hidden="true">↗</b></a>
          <details class="cp-lagun-original"><summary data-cp-product-info-title="table">Weitere Produktdetails</summary><div data-cp-product-description="table"></div><a data-cp-product-link="table" target="_blank" rel="noopener">Produktseite mit allen Bildern öffnen ↗</a></details>
        </section>
        <section class="cp-lagun-step cp-lagun-custom" id="cp-lagun-step-service" data-cp-step="service" {{ service_guide.shopify_attributes }}>
          <div class="cp-lagun-step__heading"><span class="cp-lagun-step__number">06</span><div><p>PASSEND FÜR DEINEN EINBAU</p><h2>{{ service_guide.settings.title | escape }}</h2></div></div>
          <div class="cp-lagun-custom__intro">{{ service_guide.settings.intro }}</div>
          <details><summary>Beispiele: Wann hilft eine Anpassung?</summary>{{ service_guide.settings.examples }}</details>
          <label class="cp-lagun-check cp-lagun-custom__activate"><input type="checkbox" data-cp-choice="service"><span><strong>{{ service_guide.settings.activate_label | escape }}</strong><small>Optional · deine Angaben werden zusammen mit dem Service im Warenkorb gespeichert.</small><b data-cp-service-price></b></span></label>
          <div data-cp-service-fields hidden>
            <h3>{{ service_guide.settings.handles_title | escape }}</h3>
            <div class="cp-lagun-custom__grid">
              <label>{{ service_guide.settings.leg_label | escape }}<select data-cp-service-field="legHandle"><option value="original">So lassen</option><option value="opposite">Griff umdrehen</option></select></label>
              <label>{{ service_guide.settings.arm_label | escape }}<select data-cp-service-field="armHandle"><option value="original">So lassen</option><option value="opposite">Griff umdrehen</option></select></label>
            </div>
            <label class="cp-lagun-custom__notes">{{ service_guide.settings.notes_label | escape }}<textarea data-cp-service-field="instructions" maxlength="1000" rows="3" placeholder="Zum Beispiel: den oberen Griff am Zwei-Griff-Bein umsetzen. Beim zweiten Arm bitte genau angeben, welcher Arm betroffen ist."></textarea></label>
            <label class="cp-lagun-check"><input type="checkbox" data-cp-service-field="shorten"><span><strong>{{ service_guide.settings.shorten_label | escape }}</strong><small>Ich möchte eine kürzere Metalllänge als bei meinem gewählten Bein.</small></span></label>
            <div class="cp-lagun-custom__measure" data-cp-service-measure {% if service_guide.settings.image %}data-custom-image="true"{% endif %} hidden>
              {% assign measure_photo = service_guide.settings.image | default: legs.featured_image %}{{ measure_photo | image_url: width: 500 | image_tag: loading: 'lazy', alt: 'Lagun Tischbein: Für das Kürzen nur das Metall ohne den schwarzen Kunststoffbolzen messen' }}
              <div>{{ service_guide.settings.measure }}<label>{{ service_guide.settings.length_label | escape }} <span class="cp-lagun-custom__length"><input type="number" min="170" max="699" step="1" inputmode="numeric" data-cp-service-field="length" placeholder="z. B. 450" aria-describedby="cp-lagun-length-help"> mm</span></label><p id="cp-lagun-length-help" data-cp-length-help></p></div>
            </div>
            <p class="cp-lagun-custom__validation" data-cp-service-validation role="status"></p>
          </div>
          <p><a href="{{ adjustment_service.url }}">Alle Details zum Anpassungsservice ↗</a> · <a href="{{ section.settings.contact_link | default: '/pages/contact' }}">Foto schicken und Einbau besprechen ↗</a></p>
        </section>

      </div>

      <aside class="cp-lagun-summary" data-cp-lagun-summary aria-label="Deine Lagun-Konfiguration">
        <div class="cp-lagun-summary__sticky">
          <button class="cp-lagun-summary__mobile-toggle" type="button" aria-expanded="false" aria-controls="cp-lagun-summary-details-{{ section.id }}" data-cp-summary-toggle><span class="cp-lagun-mobile-title" data-cp-mobile-title>Dein Lagun</span> <span data-cp-progress-mini>0 / 4</span><b data-cp-mobile-price>Auswahl ansehen ↑</b></button>
          <div class="cp-lagun-summary__content" data-cp-summary-content id="cp-lagun-summary-content-{{ section.id }}">
            <div class="cp-lagun-summary__heading"><div><p class="cp-lagun-kicker">STÜCK FÜR STÜCK</p><h2>Dein Tisch. Deine Auswahl.</h2></div><span data-cp-count>0/4</span></div>
            {% render 'cp-lagun-assembly', section: section %}
            <div class="cp-lagun-summary__colors" role="group" aria-label="Farbe jederzeit wechseln"><span>Dein Look</span><button type="button" data-cp-color="silver" aria-pressed="false"><i class="cp-lagun-swatch cp-lagun-swatch--silver"></i>Silber</button><button type="button" data-cp-color="black" aria-pressed="false"><i class="cp-lagun-swatch cp-lagun-swatch--black"></i>Schwarz</button></div>
            <div class="cp-lagun-progress-track" aria-hidden="true"><i data-cp-progress-bar></i></div>
            <p class="cp-lagun-summary__progress" data-cp-progress aria-live="polite">Wähle deine Bauteile – wir behalten den Überblick.</p>
          </div>
          <div class="cp-lagun-summary__footer" id="cp-lagun-summary-details-{{ section.id }}">
            <div class="cp-lagun-success" data-cp-success role="status" hidden><span aria-hidden="true">✓</span><div><strong data-cp-success-title></strong><p data-cp-success-copy></p><button type="button" data-cp-jump="table" data-cp-success-next>Tischplatte auswählen →</button></div></div>
            <details class="cp-lagun-price-details" data-cp-price-details>
              <summary class="cp-lagun-summary__total"><span>Jetzt ergänzen<small data-cp-price-description>Bestandteile &amp; Einzelpreise ansehen</small></span><strong data-cp-summary-total>0,00 €</strong><span class="cp-price-chevron" aria-hidden="true">⌄</span></summary>
              <div class="cp-lagun-price-breakdown"><p>Neu gewählte Artikel werden jeweils einmal ergänzt. Vorhandene Warenkorbteile kosten hier nichts zusätzlich.</p><ul class="cp-lagun-summary__items" data-cp-summary-items></ul></div>
            </details>
            <small class="cp-lagun-cart-caption" data-cp-summary-cart></small>
            <p class="cp-lagun-summary__tax">{% if cart.taxes_included and localization.country.iso_code != 'CH' %}Inkl. MwSt. · {% endif %}<a href="/pages/zahlung-und-versand-1">Versand im Checkout</a></p>
            <button type="button" class="cp-lagun-summary__add" data-cp-add disabled>Zum Warenkorb hinzufügen</button>
            <button type="button" class="cp-lagun-summary__checkout" data-cp-checkout disabled>Direkt zur Kasse →</button>
            <p class="cp-lagun-checkout-note">Mit deiner Auswahl und den übrigen Warenkorbartikeln.</p>
            {% if section.settings.purchase_proof_enabled %}
              <details class="cp-lagun-purchase-proof" data-cp-purchase-proof hidden>
                <summary><span aria-hidden="true">✓</span><span><strong data-cp-purchase-count></strong><small>kauften eine ähnliche Gestellkombination</small></span><b aria-hidden="true">⌄</b></summary>
                <p><strong>Verglichen mit:</strong> <span data-cp-purchase-label></span></p>
                <p data-cp-purchase-period></p>
                <p>Gezählt werden Kunden mit diesen Bauteilen in ihrer zusammengefassten Kaufhistorie. Tischplatten und Anpassungsservice gehören nicht zum Vergleich.</p>
              </details>
            {% endif %}
            <p class="cp-lagun-summary__status" data-cp-status role="status"></p>
            <a class="cp-lagun-summary__help" href="{{ section.settings.contact_link | default: '/pages/contact' }}">Foto oder Maße schicken – wir beraten dich. ↗</a>
          </div>
        </div>
      </aside>
    </div>
  </div>
  <noscript><p class="page-width">Bitte aktiviere JavaScript für die gemeinsame Konfiguration. Alle Teile findest du auch in unserer <a href="/collections/brands-lagun">Lagun-Übersicht</a>.</p></noscript>
</section>
{% schema %}
{
  "name": "Lagun – Konfigurator",
  "tag": "section",
  "class": "cp-lagun-configurator-section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Übertitel",
      "default": "DEIN AUSBAU. DEINE FREIHEIT."
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Überschrift",
      "default": "Dein Lagun. Passt zu <em>dir.</em>"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Einleitung",
      "default": "Frühstücken, am Laptop arbeiten oder Platz zum Einsteigen schaffen: Stell dir den Tisch zusammen, der zu deinem Sitzplatz und deinem Alltag im Camper passt."
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Camper-Foto im Einstieg"
    },
    {
      "type": "collection",

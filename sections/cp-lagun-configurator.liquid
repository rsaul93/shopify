    },
    {
      "type": "product",
      "id": "product_under_table",
      "label": "Untertischplatte Standard"
    },
    {
      "type": "product",
      "id": "product_folding_under_table",
      "label": "Untertischplatte mit Klappachse"
    },
    {
      "type": "product",
      "id": "product_gap",
      "label": "GAP Standard"

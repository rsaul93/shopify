    },
    {
      "type": "product",
      "id": "product_adjustable_leg",
      "label": "Bein mit zwei Griffen"
    },
    {
      "type": "product",
      "id": "product_arm_silver",
      "label": "400-mm-Arm · Silber"
    },
    {
      "type": "product",
      "id": "product_arm_black",
      "label": "400-mm-Arm · Schwarz"
    },
    {
      "type": "product",
      "id": "product_extra_arm",
      "label": "Verlängerung mit Bolzen · Schwarz"
    },
    {
      "type": "product",
      "id": "product_extra_arm_silver",

{% render 'cp-lagun-immersive', product: product, mode: 'hotspots', module_section: section %}

{% schema %}
{
  "name": "Lagun – Bauteile",
  "tag": "section",
  "class": "cp-lagun-editor-section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Produktansicht", "info": "Leer lassen, um das Vorschaubild des 360°-Videos zu verwenden." },
    { "type": "text", "id": "kicker", "label": "Übertitel", "default": "So funktioniert dein Lagun" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Vier Bauteile. Maximale Bewegungsfreiheit." },
    { "type": "textarea", "id": "body", "label": "Text", "default": "Scrolle weiter und sieh direkt am Produkt, welche Aufgabe jedes Bauteil für dich übernimmt." },
    { "type": "text", "id": "status_text", "label": "Status in den Karten", "default": "In deinem ausgewählten Lagun-Set enthalten" }
  ],
  "blocks": [
    {
      "type": "component",
      "name": "Bauteil-Hotspot",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "eyebrow", "label": "Positionshinweis", "default": "Teil des Lagun-Sets" },
        { "type": "text", "id": "heading", "label": "Bauteil", "default": "Bauteil" },
        { "type": "textarea", "id": "body", "label": "Erklärung", "default": "Kurze Erklärung dieses Bauteils." },
        { "type": "range", "id": "position_x", "label": "Fokuspunkt horizontal im Originalbild", "min": 5, "max": 95, "step": 1, "unit": "%", "default": 50, "info": "Bleibt beim Skalieren und Zuschneiden am gewählten Bildpunkt verankert." },
        { "type": "range", "id": "position_y", "label": "Fokuspunkt vertikal im Originalbild", "min": 5, "max": 95, "step": 1, "unit": "%", "default": 50, "info": "Bleibt beim Skalieren und Zuschneiden am gewählten Bildpunkt verankert." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lagun – Bauteile",
      "blocks": [{ "type": "component" }, { "type": "component" }, { "type": "component" }, { "type": "component" }]
    }
  ]
}
{% endschema %}

{% render 'cp-lagun-immersive', product: product, mode: 'spin', module_section: section %}

{% schema %}
{
  "name": "Lagun – 360°",
  "tag": "section",
  "class": "cp-lagun-editor-section",
  "settings": [
    { "type": "video", "id": "video", "label": "360°-Video", "info": "Leer lassen, um das erste Produktvideo zu verwenden." },
    { "type": "text", "id": "kicker", "label": "Übertitel", "default": "Rundum ansehen" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Sieh selbst, wie wenig Platz Flexibilität braucht." },
    { "type": "textarea", "id": "body", "label": "Text", "default": "Scrolle weiter und entdecke, wie Arme, Bein und Platten als bewegliches System zusammenspielen." },
    { "type": "text", "id": "progress_label", "label": "Scroll-Hinweis", "default": "Scrollen und entdecken" },
    { "type": "text", "id": "progress_end", "label": "Ziel-Beschriftung", "default": "360°" }
  ],
  "blocks": [
    {
      "type": "chapter",
      "name": "360°-Kapitel",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "heading", "label": "Titel", "default": "Schlanke Silhouette" },
        { "type": "text", "id": "body", "label": "Kurztext", "default": "Wenig Gewicht und kaum Platzbedarf." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lagun – 360°",
      "blocks": [{ "type": "chapter" }, { "type": "chapter" }, { "type": "chapter" }]
    }
  ]
}
{% endschema %}

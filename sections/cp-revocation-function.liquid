<section class="cp-revocation page-width" id="vertrag-widerrufen" data-cp-revocation data-endpoint="https://b2b.camping-pioneers.de/widerruf-api/v1/revocations" data-locale="{{ request.locale.iso_code | escape }}">
  <div class="cp-revocation__card">
    <h2>{{ cp_title }}</h2>
    <p>{{ cp_intro }}</p>
    <form class="cp-revocation__form" data-form novalidate>
      <div data-entry-step>
        <div class="cp-revocation__grid">
          <label><span>{{ cp_name }} *</span><input type="text" name="name" autocomplete="name" maxlength="160" required></label>
          <label><span>{{ cp_email }} *</span><input type="email" name="email" autocomplete="email" maxlength="254" required></label>
          <label><span>{{ cp_contract }} *</span><input type="text" name="contractId" autocomplete="off" maxlength="100" required></label>
          <label><span>{{ cp_date }}</span><input type="date" name="orderDate"></label>
        </div>
        <label><span>{{ cp_items }}</span><textarea name="items" rows="3" maxlength="1000"></textarea></label>
        <label><span>{{ cp_note }}</span><textarea name="note" rows="3" maxlength="2000"></textarea></label>
        <label class="cp-revocation__honeypot" aria-hidden="true">Website<input type="text" name="website" tabindex="-1" autocomplete="off"></label>
        <p class="cp-revocation__privacy">{{ cp_privacy }} <a href="{{ routes.root_url }}pages/datenschutzerklarung">{{ cp_privacy_link }}</a></p>
        <button class="button button--primary" type="submit">{{ cp_review }}</button>
      </div>
      <div data-review-step hidden>
        <h3 tabindex="-1" data-review-heading>{{ cp_review_title }}</h3>
        <p>{{ cp_review_intro }}</p>
        <dl class="cp-revocation__summary" data-summary></dl>
        <div class="cp-revocation__actions">
          <button class="button button--secondary" type="button" data-back>{{ cp_back }}</button>
          <button class="button button--primary" type="button" data-confirm data-label="{{ cp_confirm | escape }}" data-sending="{{ cp_sending | escape }}">{{ cp_confirm }}</button>
        </div>
      </div>
      <div class="cp-revocation__status" role="status" aria-live="polite" data-status></div>
      <div class="cp-revocation__success" role="status" tabindex="-1" data-success hidden>
        <h3>{{ cp_success }}</h3>
        <p>{{ cp_email_notice }}</p>
        <p><strong>{{ cp_reference }}:</strong> <span data-reference></span><br><strong>{{ cp_received }}:</strong> <span data-received></span></p>
        <button class="button button--secondary" type="button" onclick="window.print()">{{ cp_print }}</button>
      </div>
    </form>
    <noscript><p>Für die elektronische Widerrufsfunktion muss JavaScript aktiviert sein. Alternativ können Sie Ihren Widerruf an <a href="mailto:info@camping-pioneers.de">info@camping-pioneers.de</a> senden.</p></noscript>
  </div>
</section>

<style>
  .cp-revocation { padding-top: 20px; padding-bottom: 60px; }
  .cp-revocation__card { max-width: 820px; margin-inline: auto; padding: clamp(22px, 4vw, 42px); border: 2px solid rgb(var(--color-border)); border-radius: 12px; background: rgb(var(--color-background)); box-shadow: 0 10px 30px rgba(0,0,0,.07); }
  .cp-revocation__card h2 { margin-top: 0; }
  .cp-revocation__grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 18px; }
  .cp-revocation label { display: block; margin-bottom: 18px; font-weight: 700; }
  .cp-revocation label span { display: block; margin-bottom: 6px; }
  .cp-revocation input, .cp-revocation textarea { width: 100%; padding: 12px; border: 1px solid #777; border-radius: 4px; background: #fff; color: #111; font: inherit; }
  .cp-revocation input:focus, .cp-revocation textarea:focus { outline: 3px solid #ffed00; outline-offset: 2px; border-color: #111; }
  .cp-revocation__privacy { margin: 0 0 20px; font-size: .9em; }
  .cp-revocation__honeypot { position: absolute !important; inset-inline-start: -10000px !important; width: 1px !important; height: 1px !important; overflow: hidden !important; }
  .cp-revocation__summary { margin: 22px 0; padding: 18px; background: rgba(var(--color-foreground),.06); border-radius: 6px; }
  .cp-revocation__summary div { display: grid; grid-template-columns: minmax(150px, 1fr) 2fr; gap: 14px; padding: 8px 0; border-bottom: 1px solid rgba(var(--color-foreground),.16); }
  .cp-revocation__summary div:last-child { border-bottom: 0; }
  .cp-revocation__summary dt { font-weight: 700; }
  .cp-revocation__summary dd { margin: 0; white-space: pre-wrap; overflow-wrap: anywhere; }
  .cp-revocation__actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .cp-revocation__status:not(:empty) { margin-top: 18px; padding: 14px; border-left: 4px solid #b00020; background: #fff2f3; color: #710014; }
  .cp-revocation__success { padding: 22px; border-left: 5px solid #16833b; background: #eefaf1; color: #102f19; }
  .cp-revocation__success h3 { margin-top: 0; }
  @media (max-width: 749px) { .cp-revocation__grid { grid-template-columns: 1fr; gap: 0; } .cp-revocation__summary div { grid-template-columns: 1fr; gap: 3px; } }
  @media print { header, footer, .shopify-section-announcement-bar, .cp-revocation__card > h2, .cp-revocation__card > p, [data-entry-step], [data-review-step], .cp-revocation__status { display: none !important; } .cp-revocation__success { display: block !important; border: 1px solid #000; } }
</style>

<script>
(() => {
  const root = document.querySelector('[data-cp-revocation]');
  if (!root || root.dataset.ready === 'true') return;
  root.dataset.ready = 'true';
  const form = root.querySelector('[data-form]');
  const entry = root.querySelector('[data-entry-step]');
  const review = root.querySelector('[data-review-step]');
  const summary = root.querySelector('[data-summary]');
  const status = root.querySelector('[data-status]');
  const success = root.querySelector('[data-success]');
  const confirmButton = root.querySelector('[data-confirm]');
  const labels = {};
  form.querySelectorAll('label').forEach((label) => {
    const control = label.querySelector('input,textarea');
    const title = label.querySelector('span');
    if (control && title) labels[control.name] = title.textContent.replace(/\s*\*$/, '');
  });
  const values = () => Object.fromEntries(new FormData(form).entries());
  form.addEventListener('submit', (event) => {
    event.preventDefault();
    status.textContent = '';
    if (!form.checkValidity()) { form.reportValidity(); return; }
    const data = values();
    summary.textContent = '';
    ['name','email','contractId','orderDate','items','note'].forEach((name) => {
      if (!data[name]) return;
      const row = document.createElement('div');
      const term = document.createElement('dt');
      const detail = document.createElement('dd');
      term.textContent = labels[name] || name;
      detail.textContent = data[name];
      row.append(term, detail);
      summary.append(row);
    });
    entry.hidden = true;
    review.hidden = false;
    root.querySelector('[data-review-heading]').focus();
  });
  root.querySelector('[data-back]').addEventListener('click', () => {
    review.hidden = true;
    entry.hidden = false;
    form.elements.name.focus();
  });
  confirmButton.addEventListener('click', async () => {
    confirmButton.disabled = true;
    confirmButton.textContent = confirmButton.dataset.sending;
    status.textContent = '';
    try {
      const response = await fetch(root.dataset.endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ...values(), locale: root.dataset.locale }),
      });
      const result = await response.json();
      if (!response.ok || !result.ok) throw new Error(result.error || 'Request failed');
      review.hidden = true;
      success.hidden = false;
      success.querySelector('[data-reference]').textContent = result.reference;
      success.querySelector('[data-received]').textContent = result.receivedAt;
      success.focus();
      form.reset();
    } catch (error) {
      status.textContent = error && error.message ? error.message : '{{ cp_error | escape }}';
      confirmButton.disabled = false;
      confirmButton.textContent = confirmButton.dataset.label;
    }
  });
})();
</script>


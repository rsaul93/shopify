    "custom_liquid_7mmbeH": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<div class=\"cp-searchbar\" data-cp-search>\n  <form action=\"{{ routes.search_url }}\" method=\"get\" role=\"search\" class=\"cp-searchbar__form\">\n    <div class=\"cp-searchbar__field\">\n      <input\n        class=\"cp-searchbar__input\"\n        type=\"search\"\n        name=\"q\"\n        placeholder=\"Suche nach Tischgestellen, Dachzelten & Anhängern…\"\n        aria-label=\"Suche\"\n        autocomplete=\"off\"\n        data-cp-search-input\n      >\n      <span class=\"cp-searchbar__icon\" aria-hidden=\"true\">🔍</span>\n    </div>\n\n    <!-- Shopify-Option: prefix matching (letztes Wort) -->\n    <input type=\"hidden\" name=\"options[prefix]\" value=\"last\">\n  </form>\n\n  <div class=\"cp-searchbar__dropdown\" data-cp-search-dropdown hidden>\n    <ul class=\"cp-searchbar__list\" data-cp-search-list></ul>\n  </div>\n</div>\n\n<style>\n  :root{ --cp-brand:#092C91; }\n\n  .cp-searchbar{\n    max-width: 820px;\n    margin: 6px auto;\n    padding: 0 16px;\n    position: relative;\n  }\n\n  .cp-searchbar__form{ margin: 0; }\n\n  /* Feld (Underline + Glow) */\n  .cp-searchbar__field{\n    position: relative;\n    display:flex;\n    align-items:center;\n    background: transparent;\n    border-bottom: 1px solid rgba(0,0,0,.12);\n    transition: box-shadow .2s ease, border-color .2s ease;\n  }\n\n  /* Glow in Markenfarbe (ohne extra Linie) */\n  .cp-searchbar__field:focus-within{\n    box-shadow: 0 8px 22px rgba(9,44,145,.18);\n  }\n\n  .cp-searchbar__input{\n    width: 100%;\n    padding: 6px 34px 6px 4px; /* rechts Platz für Lupe */\n    border: none;\n    background: transparent;\n    font-size: 15px;\n    line-height: 1.2;\n  }\n\n  .cp-searchbar__input::placeholder{ opacity:.6; }\n  .cp-searchbar__input:focus{ outline:none; }\n\n  /* Lupe dezent im Feld rechts */\n  .cp-searchbar__icon{\n    position:absolute;\n    right: 4px;\n    top: 50%;\n    transform: translateY(-50%);\n    width: 28px;\n    height: 28px;\n    display:flex;\n    align-items:center;\n    justify-content:center;\n    opacity: .55;\n    pointer-events: none;\n    line-height: 1;\n  }\n\n  /* Dropdown */\n  .cp-searchbar__dropdown{\n    position:absolute;\n    left:16px;\n    right:16px;\n    top: calc(100% + 8px);\n    background:#fff;\n    border-radius: 8px;\n    box-shadow: 0 6px 18px rgba(0,0,0,.06);\n    border: 1px solid rgba(0,0,0,.06);\n    overflow:hidden;\n    z-index:50;\n  }\n\n  .cp-searchbar__list{\n    list-style:none;\n    margin:0;\n    padding:4px 0;\n  }\n\n  .cp-searchbar__item a{\n    display:block;\n    padding:8px 14px;\n    font-size:14px;\n    text-decoration:none;\n    color:inherit;\n  }\n\n  .cp-searchbar__item a:hover{\n    background: rgba(0,0,0,.03);\n  }\n\n  .cp-searchbar__muted{\n    font-size:12px;\n    opacity:.5;\n    margin-left:6px;\n    white-space: nowrap;\n  }\n\n  /* Section titles + Divider */\n  .cp-searchbar__section-title{\n    padding: 10px 14px 6px;\n    font-size: 12px;\n    letter-spacing: .02em;\n    text-transform: uppercase;\n    opacity: .6;\n  }\n\n  .cp-searchbar__divider{\n    height: 1px;\n    background: rgba(0,0,0,.06);\n    margin: 6px 0;\n  }\n</style>\n\n<script>\n(() => {\n  const root = document.querySelector('[data-cp-search]');\n  if (!root) return;\n\n  const input = root.querySelector('[data-cp-search-input]');\n  const dropdown = root.querySelector('[data-cp-search-dropdown]');\n  const list = root.querySelector('[data-cp-search-list]');\n  let t = null;\n\n  const close = () => {\n    dropdown.hidden = true;\n    list.innerHTML = '';\n  };\n\n  const open = () => { dropdown.hidden = false; };\n\n  const escapeHtml = (s) =>\n    String(s).replace(/[&<>\"']/g, m => ({\n      '&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#039;'\n    }[m]));\n\n  const fetchSuggestions = async (q) => {\n    // ✅ Produkte + Seiten + Kollektionen + Blogartikel\n    const url =\n      `/search/suggest.json?q=${encodeURIComponent(q)}` +\n      `&resources[type]=product,page,collection,article` +\n      `&resources[limit]=16` +\n      `&resources[options][unavailable_products]=last` +\n      `&resources[options][fields]=title,product_type`;\n\n    const res = await fetch(url, { headers: { 'Accept': 'application/json' } });\n    if (!res.ok) return { products: [], pages: [], collections: [], articles: [] };\n\n    const data = await res.json();\n\n    const products = (data?.resources?.results?.products || []).map(p => ({\n      kind: 'product',\n      title: p.title,\n      url: p.url,\n      meta: p.product_type || 'Produkt'\n    }));\n\n    const pages = (data?.resources?.results?.pages || []).map(p => ({\n      kind: 'page',\n      title: p.title,\n      url: p.url,\n      meta: 'Seite'\n    }));\n\n    const collections = (data?.resources?.results?.collections || []).map(c => ({\n      kind: 'collection',\n      title: c.title,\n      url: c.url,\n      meta: 'Kollektion'\n    }));\n\n    const articles = (data?.resources?.results?.articles || []).map(a => ({\n      kind: 'article',\n      title: a.title,\n      url: a.url,\n      meta: 'Ratgeber'\n    }));\n\n    return { products, pages, collections, articles };\n  };\n\n  const renderSection = (title, items, limit) => {\n    const sliced = items.slice(0, limit);\n    if (!sliced.length) return '';\n\n    const rows = sliced.map(i => `\n      <li class=\"cp-searchbar__item\">\n        <a href=\"${escapeHtml(i.url)}\">\n          ${escapeHtml(i.title)}\n          ${i.meta ? `<span class=\"cp-searchbar__muted\">${escapeHtml(i.meta)}</span>` : ``}\n        </a>\n      </li>\n    `).join('');\n\n    return `\n      <li class=\"cp-searchbar__section-title\">${escapeHtml(title)}</li>\n      ${rows}\n    `;\n  };\n\n  const render = ({ products, pages, collections, articles }) => {\n    if (!products.length && !pages.length && !collections.length && !articles.length) {\n      close(); return;\n    }\n\n    // ✅ Priorität: Produkte → Seiten → Kollektionen → Ratgeber\n    // Limits: so bleibt es übersichtlich, aber „alles“ ist drin.\n    const p  = renderSection('Produkte',     products,    6);\n    const pg = renderSection('Seiten',       pages,       4);\n    const co = renderSection('Kollektionen', collections, 4);\n    const ar = renderSection('Ratgeber',     articles,    3);\n\n    const parts = [];\n    const add = (html) => {\n      if (!html) return;\n      if (parts.length) parts.push(`<li class=\"cp-searchbar__divider\"></li>`);\n      parts.push(html);\n    };\n\n    add(p);\n    add(pg);\n    add(co);\n    add(ar);\n\n    list.innerHTML = parts.join('');\n    open();\n  };\n\n  input.addEventListener('input', () => {\n    const q = input.value.trim();\n    clearTimeout(t);\n\n    if (q.length < 2) { close(); return; }\n\n    t = setTimeout(async () => {\n      try {\n        const results = await fetchSuggestions(q);\n        render(results);\n      } catch {\n        close();\n      }\n    }, 140);\n  });\n\n  input.addEventListener('focus', () => {\n    if (list.children.length) open();\n  });\n\n  document.addEventListener('click', e => {\n    if (!root.contains(e.target)) close();\n  });\n\n  document.addEventListener('keydown', e => {\n    if (e.key === 'Escape') close();\n  });\n})();\n</script>",
        "full_width": false,
        "show_divider": false,
        "padding_top": 20,
        "padding_bottom": 20
      }
    }
  },
  "order": [
    "announcement-bar",
    "header",
    "custom_liquid_7mmbeH"
  ]
}

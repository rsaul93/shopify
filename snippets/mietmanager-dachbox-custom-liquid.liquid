<section class="cp-dachbox-page">
  <style>
    .cp-dachbox-page{--cp-blue:#2B00FF;--cp-navy:#092C91;--cp-text:#171717;--cp-muted:#62666f;--cp-line:#e6e8ef;--cp-soft:#f5f7fb;color:var(--cp-text)}
    .cp-dachbox-hero{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(280px,.95fr);gap:32px;align-items:center;padding:42px 0 34px}
    .cp-dachbox-eyebrow{margin:0 0 10px;color:var(--cp-blue);font-weight:800;text-transform:uppercase;font-size:13px;letter-spacing:.08em}
    .cp-dachbox-hero h1{margin:0;font-size:clamp(32px,5vw,58px);line-height:1.02;letter-spacing:0;color:var(--cp-text)}
    .cp-dachbox-lead{margin:18px 0 0;font-size:18px;line-height:1.55;color:var(--cp-muted);max-width:680px}
    .cp-dachbox-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:24px}
    .cp-dachbox-btn{display:inline-flex;align-items:center;justify-content:center;min-height:46px;padding:0 18px;border-radius:6px;text-decoration:none;font-weight:800;border:1px solid var(--cp-blue)}
    .cp-dachbox-btn.primary{background:var(--cp-blue);color:#fff}.cp-dachbox-btn.secondary{background:#fff;color:var(--cp-blue)}
    .cp-dachbox-hero img{width:100%;aspect-ratio:4/3;object-fit:contain;background:var(--cp-soft);border-radius:8px}
    .cp-dachbox-note{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin:10px 0 32px}
    .cp-dachbox-note div{border:1px solid var(--cp-line);border-radius:8px;padding:14px 16px;background:#fff}
    .cp-dachbox-note strong{display:block;margin-bottom:4px}.cp-dachbox-note span{color:var(--cp-muted);font-size:14px;line-height:1.45}
    .cp-dachbox-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;margin:24px 0 42px}
    .cp-dachbox-card{border:1px solid var(--cp-line);border-radius:8px;overflow:hidden;background:#fff;display:flex;flex-direction:column}
    .cp-dachbox-card img{width:100%;aspect-ratio:4/3;object-fit:contain;background:var(--cp-soft);padding:12px;box-sizing:border-box}
    .cp-dachbox-card__body{padding:16px;display:flex;flex-direction:column;gap:10px;flex:1}.cp-dachbox-kicker{margin:0;color:var(--cp-blue);font-weight:800;font-size:12px;text-transform:uppercase;letter-spacing:.08em}
    .cp-dachbox-card h3{margin:0;font-size:20px;line-height:1.2}.cp-dachbox-card ul{margin:0;padding-left:18px;color:var(--cp-muted);font-size:14px;line-height:1.45;flex:1}
    .cp-dachbox-card__link{color:var(--cp-blue);font-weight:800;text-decoration:none}
    .cp-dachbox-form{border:1px solid var(--cp-line);border-radius:8px;background:var(--cp-soft);padding:24px;margin:0 0 42px}.cp-dachbox-form h2{margin:0 0 8px;font-size:28px}.cp-dachbox-form p{color:var(--cp-muted);margin:0 0 18px}
    .cp-dachbox-fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.cp-dachbox-fields label{display:flex;flex-direction:column;gap:6px;font-weight:700;font-size:14px}
    .cp-dachbox-fields input,.cp-dachbox-fields select,.cp-dachbox-fields textarea{border:1px solid var(--cp-line);border-radius:6px;padding:12px;font:inherit;background:#fff}.cp-dachbox-fields .wide{grid-column:1/-1}
    @media(max-width:900px){.cp-dachbox-hero,.cp-dachbox-note,.cp-dachbox-grid{grid-template-columns:1fr}.cp-dachbox-fields{grid-template-columns:1fr}}
  </style>

  <div id="dachbox-anfrage" class="cp-dachbox-form">
    <h2>Dachbox anfragen</h2>
    <p>Schick uns Modell, Zeitraum und Fahrzeugdaten. Wir prüfen die Verfügbarkeit und melden uns persönlich.</p>
    {% form 'contact', id: 'ContactDachboxen' %}
      <input type="hidden" name="contact[tags]" value="dachbox,gotti,partner">
      <div class="cp-dachbox-fields">
        <label>Name<input type="text" name="contact[name]" required></label>
        <label>E-Mail<input type="email" name="contact[email]" required></label>
        <label>Telefon<input type="tel" name="contact[Telefon]"></label>
        <label>Dachbox<select name="contact[Dachbox]"><option value="">Bitte auswählen</option><option value="Thule Motion 3 XXL">Thule Motion 3 XXL</option>
<option value="Thule Motion XT XXL">Thule Motion XT XXL</option>
<option value="Thule Motion 3 XL">Thule Motion 3 XL</option>
<option value="Thule Motion 3 XL weiß">Thule Motion 3 XL weiß</option>
<option value="Thule Motion XT XL">Thule Motion XT XL</option>
<option value="Thule Force 3 XL">Thule Force 3 XL</option>
<option value="Thule Force XT XL">Thule Force XT XL</option>
<option value="Thule Pulse 2 XL">Thule Pulse 2 XL</option>
<option value="Thule Pulse 2 L">Thule Pulse 2 L</option>
<option value="Thule Force 3 L">Thule Force 3 L</option>
<option value="Thule Force XT L">Thule Force XT L</option>
<option value="Thule Pacific L 780">Thule Pacific L 780</option>
<option value="Thule Touring L">Thule Touring L</option>
<option value="Thule Pacific 780 DS">Thule Pacific 780 DS</option>
<option value="Thule Touring 780">Thule Touring 780</option>
<option value="Thule Touring M">Thule Touring M</option>
<option value="Thule Force 3 M">Thule Force 3 M</option>
<option value="Thule Touring S">Thule Touring S</option>
<option value="Thule Arcos Box XL">Thule Arcos Box XL</option></select></label>
        <label>Von<input type="date" name="contact[Mietbeginn]"></label>
        <label>Bis<input type="date" name="contact[Mietende]"></label>
        <label class="wide">Fahrzeug / Dachträger / Hinweise<textarea name="contact[body]" rows="5" placeholder="Fahrzeugmodell, vorhandene Dachträger, Reiseziel oder besondere Wünsche"></textarea></label>
      </div>
      <button class="cp-dachbox-btn primary" type="submit" style="margin-top:16px">Anfrage senden</button>
    {% endform %}
  </div>
  <script>
    document.querySelectorAll('.cp-dachbox-card__link[data-dachbox]').forEach(function(link){
      link.addEventListener('click', function(){
        var select = document.querySelector('#ContactDachboxen select[name="contact[Dachbox]"]');
        if (select) select.value = link.getAttribute('data-dachbox') || '';
      });
    });
  </script>
</section>
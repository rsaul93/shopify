<style>
  .cpb-wrap {
    --cpb-blue: #2B00FF;
    --cpb-blue-light: rgba(43,0,255,0.10);
    --cpb-blue-mid: rgba(43,0,255,0.18);
    --cpb-navy: #092C91;
    --cpb-border: #E5E7EB;
    --cpb-text: #1a1b18;
    --cpb-muted: #6B7280;
    --cpb-ok-bg: #d1fae5;
    --cpb-ok-fg: #065f46;
    --cpb-no-bg: #fee2e2;
    --cpb-no-fg: #991b1b;
    --cpb-card: #fff;
    color: var(--cpb-text);
    font-size: 17px;
    line-height: 1.55;
    background: #f9fafb;
    border: 1px solid var(--cpb-border);
    border-radius: 18px;
    padding: 20px;
    max-width: 980px;
    margin: 0 auto;
  }

  /* ── Header ── */
  .cpb-header { margin-bottom: 18px; }
  .cpb-brand { display: flex; align-items: center; gap: 12px; margin-bottom: 16px; }
  .cpb-brand-logo { width: 148px; height: auto; display: block; }
  .cpb-brand-name { color: var(--cpb-navy); font-size: 13px; font-weight: 800; letter-spacing: 0.08em; }
  .cpb-title { margin: 0; font-size: 22px; line-height: 1.25; font-weight: 800; color: var(--cpb-text); }
  .cpb-sub { margin: 8px 0 0; color: var(--cpb-muted); font-size: 17px; line-height: 1.55; }
  .cpb-roofrack-notice { margin: 0 0 18px; padding: 14px 16px; border: 2px solid #f59e0b; border-radius: 12px; background: #fffbeb; color: #78350f; }
  .cpb-roofrack-notice strong { display: block; margin-bottom: 4px; font-size: 17px; }
  .cpb-roofrack-notice span { display: block; font-size: 15px; line-height: 1.5; }

  /* ── Product/Location selectors ── */
  .cpb-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(160px, 1fr));
    gap: 12px;
    margin-bottom: 14px;
  }
  .cpb-field label {
    display: block;
    margin-bottom: 5px;
    font-weight: 600;
    font-size: inherit;
    color: #374151;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .cpb-input, .cpb-select {
    width: 100%;
    padding: 10px 12px;
    border: 1.5px solid var(--cpb-border);
    border-radius: 10px;
    background: #fff;
    color: var(--cpb-text);
    font-size: inherit;
    box-sizing: border-box;
  }
  .cpb-input:focus, .cpb-select:focus {
    outline: none;
    border-color: var(--cpb-blue);
    box-shadow: 0 0 0 3px rgba(43,0,255,0.10);
  }

  .cpb-product-preview {
    display: none;
    margin: 2px 0 14px;
    background: #fff;
    border: 1.5px solid var(--cpb-border);
    border-radius: 14px;
    overflow: hidden;
  }
  .cpb-product-preview-inner {
    display: grid;
    grid-template-columns: 172px minmax(0, 1fr);
    gap: 16px;
    align-items: center;
  }
  .cpb-product-image {
    width: 100%;
    height: 132px;
    object-fit: cover;
    display: block;
    background: #f3f4f6;
  }
  .cpb-product-copy {
    padding: 16px 16px 16px 0;
  }
  .cpb-product-name {
    margin: 0;
    font-size: 18px;
    line-height: 1.25;
    font-weight: 800;
    color: var(--cpb-text);
  }
  .cpb-product-meta {
    margin: 6px 0 0;
    color: var(--cpb-muted);
    font-size: 16px;
    line-height: 1.45;
  }
  .cpb-input[aria-invalid="true"], .cpb-select[aria-invalid="true"] {
    border-color: #dc2626;
    box-shadow: 0 0 0 3px rgba(220,38,38,0.10);
  }

  /* ── Calendar container ── */
  .cpb-calendar {
    background: #fff;
    border: 1.5px solid var(--cpb-border);
    border-radius: 16px;
    padding: 14px;
    margin-top: 4px;
  }
  .cpb-cal-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
  }
  .cpb-month { font-weight: 700; font-size: 17px; color: var(--cpb-navy); }
  .cpb-nav {
    border: 1.5px solid var(--cpb-border);
    background: #fff;
    border-radius: 8px;
    width: 36px;
    height: 32px;
    cursor: pointer;
    font-size: 17px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--cpb-text);
    transition: border-color 0.15s;
  }
  .cpb-nav:hover { border-color: var(--cpb-blue); }

  /* ── Weekday labels ── */
  .cpb-weekdays {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 3px 0;
    margin-bottom: 2px;
  }
  .cpb-weekdays div {
    text-align: center;
    font-size: inherit;
    font-weight: 700;
    color: var(--cpb-muted);
    padding: 3px 0;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  /* ── Day grid — NO horizontal gap, only vertical ── */
  .cpb-days {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 3px 0;
  }

  /* ── Day button ── */
  .cpb-day {
    position: relative;
    border: none;
    background: transparent;
    padding: 0;
    cursor: pointer;
    min-height: 58px;
    display: flex;
    align-items: stretch;
    justify-content: stretch;
  }
  .cpb-day[disabled] {
    opacity: 0.38;
    cursor: default;
    pointer-events: none;
  }

  /* ── Range bar (full-width background behind circle) ── */
  .cpb-bar {
    position: absolute;
    top: 6px;
    bottom: 6px;
    left: 0;
    right: 0;
    background: transparent;
    pointer-events: none;
    z-index: 0;
  }

  /* ── Circle (number + label) ── */
  .cpb-circle {
    position: relative;
    z-index: 1;
    width: 100%;
    min-height: 52px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    margin: 3px 4px;
    box-sizing: border-box;
    transition: background 0.1s;
  }
  .cpb-circle .d {
    font-weight: 700;
    font-size: inherit;
    line-height: 1.1;
  }
  .cpb-circle .s {
    font-size: 16px;
    margin-top: 2px;
    line-height: 1.1;
  }

  /* ── Available / unavailable default appearance ── */
  .cpb-day.ok .cpb-circle {
    background: var(--cpb-ok-bg);
    color: var(--cpb-ok-fg);
  }
  .cpb-day.no .cpb-circle {
    background: var(--cpb-no-bg);
    color: var(--cpb-no-fg);
  }
  .cpb-day.past .cpb-circle {
    background: #f3f4f6 !important;
    color: #9ca3af !important;
  }
  .cpb-day.past .cpb-bar {
    background: transparent !important;
  }
  .cpb-day:not([disabled]):hover .cpb-circle {
    filter: brightness(0.93);
  }

  /* ── Anchor: solid blue circle, no bar ── */
  .cpb-day.anchor .cpb-circle {
    background: var(--cpb-blue) !important;
    color: #fff !important;
  }
  .cpb-day.anchor .cpb-bar {
    background: transparent;
  }

  /* ── sel-start: blue circle, bar extends RIGHT half ── */
  .cpb-day.sel-start .cpb-circle {
    background: var(--cpb-blue) !important;
    color: #fff !important;
  }
  .cpb-day.sel-start .cpb-bar {
    left: 50%;
    right: 0;
    background: var(--cpb-blue-light);
  }

  /* ── sel-end: blue circle, bar extends LEFT half ── */
  .cpb-day.sel-end .cpb-circle {
    background: var(--cpb-blue) !important;
    color: #fff !important;
  }
  .cpb-day.sel-end .cpb-bar {
    left: 0;
    right: 50%;
    background: var(--cpb-blue-light);
  }

  /* ── in-range: full-width bar, no special circle ── */
  .cpb-day.in-range .cpb-bar {
    left: 0;
    right: 0;
    background: var(--cpb-blue-light);
  }
  .cpb-day.in-range .cpb-circle {
    background: transparent !important;
    color: var(--cpb-navy) !important;
  }

  /* ── Hint text below calendar ── */
  .cpb-hint {
    margin-top: 10px;
    font-size: inherit;
    color: var(--cpb-muted);
    min-height: 1.2em;
  }

  /* ── Slot selectors ── */
  .cpb-slots {
    display: grid;
    grid-template-columns: repeat(2, minmax(160px, 1fr));
    gap: 12px;
    margin-top: 14px;
  }

  .cpb-accessory {
    margin-top: 14px;
    background: #fff;
    border: 1.5px solid var(--cpb-border);
    border-radius: 14px;
    overflow: hidden;
  }
  .cpb-accessory-label {
    display: grid;
    grid-template-columns: 132px minmax(0, 1fr);
    gap: 14px;
    align-items: stretch;
    cursor: pointer;
  }
  .cpb-accessory-label.simple {
    grid-template-columns: 1fr;
  }
  .cpb-accessory-media {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    background: #f3f4f6;
  }
  .cpb-accessory-media img {
    width: 100%;
    height: 88px;
    object-fit: cover;
    display: block;
  }
  .cpb-accessory-body {
    display: grid;
    grid-template-columns: 24px minmax(0, 1fr);
    gap: 10px;
    padding: 14px 14px 14px 0;
    align-items: start;
  }
  .cpb-accessory-label.simple .cpb-accessory-body {
    padding: 14px;
  }
  .cpb-accessory-body input { margin-top: 3px; }
  .cpb-accessory-title {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-weight: 700;
    color: var(--cpb-text);
  }
  .cpb-accessory-price {
    color: var(--cpb-navy);
    white-space: nowrap;
  }
  .cpb-accessory-text {
    margin-top: 4px;
    color: var(--cpb-muted);
    font-size: 16px;
    line-height: 1.45;
  }

  /* ── Contact form ── */
  .cpb-contact {
    margin-top: 14px;
    display: grid;
    grid-template-columns: repeat(2, minmax(160px, 1fr));
    gap: 12px;
  }
  .cpb-contact .full { grid-column: 1 / -1; }
  .cpb-contact-note {
    grid-column: 1 / -1;
    font-size: 16px;
    color: var(--cpb-muted);
    margin-top: -4px;
  }

  /* ── Action buttons ── */
  .cpb-actions {
    margin-top: 16px;
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  .cpb-btn {
    border: none;
    border-radius: 10px;
    padding: 11px 20px;
    font-weight: 700;
    cursor: pointer;
    font-size: inherit;
    transition: opacity 0.15s;
  }
  .cpb-btn.primary {
    background: var(--cpb-blue);
    color: #fff;
  }
  .cpb-btn.primary:hover { opacity: 0.88; }
  .cpb-btn.secondary {
    background: #fff;
    color: var(--cpb-navy);
    border: 1.5px solid var(--cpb-border);
  }
  .cpb-btn.secondary:hover { border-color: var(--cpb-blue); }
  .cpb-btn[disabled] { opacity: 0.45; cursor: not-allowed; }

  /* ── Result box ── */
  .cpb-result {
    margin-top: 16px;
    background: #fff;
    border: 1.5px solid var(--cpb-border);
    border-radius: 14px;
    padding: 16px;
    line-height: 1.6;
    font-size: 17px;
  }

  /* ── Error box ── */
  .cpb-error {
    margin-top: 12px;
    background: #fef2f2;
    border: 1px solid #fca5a5;
    border-radius: 10px;
    padding: 10px 14px;
    color: #991b1b;
    font-size: 16px;
    display: none;
  }

  @media (max-width: 820px) {
    .cpb-wrap { max-width: 100%; padding: 14px; }
    .cpb-grid, .cpb-slots, .cpb-contact { grid-template-columns: 1fr; }
    .cpb-product-preview-inner { grid-template-columns: 1fr; }
    .cpb-product-image { height: 190px; }
    .cpb-product-copy { padding: 12px; }
    .cpb-accessory-label { grid-template-columns: 1fr; }
    .cpb-accessory-media { grid-template-columns: repeat(2, 1fr); }
    .cpb-accessory-body { padding: 12px; }
    .cpb-day { min-height: 52px; }
    .cpb-circle { margin: 2px 2px; min-height: 46px; }
  }
  @media (max-width: 440px) {
    .cpb-circle .s { display: none; }
  }
</style>

<div class="cpb-wrap" id="cpb-root">
  <div class="cpb-header">
    <div class="cpb-brand">
      <img class="cpb-brand-logo" src="https://cdn.shopify.com/s/files/1/0783/6696/6087/files/camping_pioneers_logo_high_quality_07.01.24_black_schwarz.webp?width=320" alt="CAMPING-PIONEERS">
      <span class="cpb-brand-name">CAMPING-PIONEERS MIETMANAGER</span>
    </div>
    <h3 class="cpb-title">Dachzelt-Miete berechnen</h3>
    <p class="cpb-sub">Wähle dein Dachzelt, Standort und Reisedaten. Du siehst den Mietpreis sofort und kannst bei passenden Qeedo- und Horntools-Dachzelten optional ein Vorzelt dazubuchen.</p>
  </div>

  <div class="cpb-roofrack-notice" role="note">
    <strong>Wichtig: Dachträger erforderlich</strong>
    <span>Für die Montage brauchst du passende Dachträger beziehungsweise Querträger. Eine Dachreling allein reicht in der Regel nicht aus; ausgenommen ist das Horntools Track. Wir vermieten aktuell keine Dachträger, können sie aber passend für dein Fahrzeug besorgen. Du bezahlst nur die Rechnung für die Dachträger.</span>
  </div>

  <div class="cpb-grid">
    <div class="cpb-field">
      <label for="cpb-product">Dachzelt</label>
      <select id="cpb-product" class="cpb-select"></select>
    </div>
    <div class="cpb-field">
      <label for="cpb-location">Standort</label>
      <select id="cpb-location" class="cpb-select"></select>
    </div>
  </div>

  <div class="cpb-product-preview" id="cpb-product-preview">
    <div class="cpb-product-preview-inner">
      <img class="cpb-product-image" id="cpb-product-image" src="" alt="" loading="eager" fetchpriority="high">
      <div class="cpb-product-copy">
        <p class="cpb-product-name" id="cpb-product-name"></p>
        <p class="cpb-product-meta" id="cpb-product-meta"></p>
      </div>
    </div>
  </div>

  <div class="cpb-calendar" id="cpb-calendar-wrap" style="display:none;">
    <div class="cpb-cal-head">
      <button type="button" class="cpb-nav" id="cpb-prev" aria-label="Monat zurück">&#8592;</button>
      <div class="cpb-month" id="cpb-month"></div>
      <button type="button" class="cpb-nav" id="cpb-next" aria-label="Monat vor">&#8594;</button>
    </div>
    <div class="cpb-weekdays">
      <div>Mo</div><div>Di</div><div>Mi</div><div>Do</div><div>Fr</div><div>Sa</div><div>So</div>
    </div>
    <div class="cpb-days" id="cpb-days"></div>
    <div class="cpb-hint" id="cpb-range-hint"></div>
  </div>

  <div class="cpb-error" id="cpb-error"></div>

  <div class="cpb-slots" id="cpb-slots" style="display:none;">
    <div class="cpb-field">
      <label for="cpb-pickup-slot">Abholung</label>
      <select id="cpb-pickup-slot" class="cpb-select"></select>
    </div>
    <div class="cpb-field">
      <label for="cpb-return-slot">Rückgabe</label>
      <select id="cpb-return-slot" class="cpb-select"></select>
    </div>
  </div>

  <div class="cpb-accessory" id="cpb-accessory" style="display:none;">
    <label class="cpb-accessory-label" for="cpb-accessory-bundle">
      <span class="cpb-accessory-media" id="cpb-accessory-media" aria-hidden="true">
        <img id="cpb-accessory-image-primary" src="https://cdn.shopify.com/s/files/1/0783/6696/6087/files/Z4007_1.jpg?v=1771343905" alt="" loading="lazy">
        <img id="cpb-accessory-image-secondary" src="https://cdn.shopify.com/s/files/1/0783/6696/6087/files/Z3954_1_13bad1f0-f3dc-4cc0-a80b-1683eab1795a.jpg?v=1771341936" alt="" loading="lazy">
      </span>
      <span class="cpb-accessory-body">
        <input id="cpb-accessory-bundle" type="checkbox" />
        <span>
          <span class="cpb-accessory-title">
            <span id="cpb-accessory-title-text">Vorzelt + Verbindungsschleuse mitnehmen</span>
            <span class="cpb-accessory-price" id="cpb-accessory-price"></span>
          </span>
          <span class="cpb-accessory-text" id="cpb-accessory-description">Mehr geschützter Raum am Stellplatz: Quick Base als freistehendes Vorzelt plus passende Schleuse zum Dachzelt. Der Aufpreis richtet sich automatisch nach deinem Mietzeitraum.</span>
        </span>
      </span>
    </label>
  </div>

  <div class="cpb-accessory" id="cpb-dog-accessory" style="display:none;">
    <label class="cpb-accessory-label simple" for="cpb-dog-accessory-checkbox">
      <span class="cpb-accessory-body">
        <input id="cpb-dog-accessory-checkbox" type="checkbox" />
        <span>
          <span class="cpb-accessory-title">
            <span>Hund mitführen</span>
            <span class="cpb-accessory-price">+50&nbsp;€</span>
          </span>
          <span class="cpb-accessory-text">Einmalige Kostenposition, unabhängig von der Mietdauer.</span>
        </span>
      </span>
    </label>
  </div>

  <div class="cpb-contact" id="cpb-contact" style="display:none;">
    <div class="cpb-field">
      <label for="cpb-name">Dein Name *</label>
      <input id="cpb-name" class="cpb-input" autocomplete="name" aria-required="true" />
    </div>
    <div class="cpb-field">
      <label for="cpb-email">E-Mail *</label>
      <input id="cpb-email" type="email" class="cpb-input" autocomplete="email" />
    </div>
    <div class="cpb-field">
      <label for="cpb-phone">Telefon *</label>
      <input id="cpb-phone" type="tel" class="cpb-input" autocomplete="tel" />
    </div>
    <div class="cpb-field">
      <label for="cpb-vehicle">Fahrzeug (optional)</label>
      <input id="cpb-vehicle" class="cpb-input" />
    </div>
    <div class="cpb-contact-note">* Pflichtfeld: Name plus E-Mail oder Telefon</div>
  </div>

  <div class="cpb-actions" id="cpb-actions" style="display:none;">
    <button type="button" class="cpb-btn primary" id="cpb-check">Preis &amp; Verfügbarkeit anzeigen</button>
    <button type="button" class="cpb-btn secondary" id="cpb-reset">Auswahl zurücksetzen</button>
  </div>

  <div class="cpb-result" id="cpb-result" style="display:none;"></div>
</div>

<script>
(function() {
  var RENTAL_KIND = 'dachzelt';
  var API_BASE = 'https://booking.camping-pioneers.de/api/public/v1';
  var ACCESSORY_BUNDLE_CODE = 'ROOF_TENT_QUICK_BASE_SCHLEUSE';
  var HORNTOOLS_ANNEX_CODE = 'ROOF_TENT_HORNTOOLS_VORZELT';
  var DOG_ACCESSORY_CODE = 'DOG_ALLOWED';
  var DOG_ACCESSORY_PRICE = 50;
  var QEEDO_ACCESSORY_IMAGE_PRIMARY = 'https://cdn.shopify.com/s/files/1/0783/6696/6087/files/Z4007_1.jpg?v=1771343905';
  var QEEDO_ACCESSORY_IMAGE_SECONDARY = 'https://cdn.shopify.com/s/files/1/0783/6696/6087/files/Z3954_1_13bad1f0-f3dc-4cc0-a80b-1683eab1795a.jpg?v=1771341936';
  var initProductId = {{ product.id | default: blank | json }};
  var initVariantId = {{ product.selected_or_first_available_variant.id | default: blank | json }};
  var initKaution = {{ product.metafields.custom.kaution | default: '' | json }};
  var SHOP_DOMAIN = {{ shop.permanent_domain | json }};
  var PAGE_PATH = {{ request.path | json }};

  var els = {
    root:     document.getElementById('cpb-root'),
    product:  document.getElementById('cpb-product'),
    location: document.getElementById('cpb-location'),
    productPreview: document.getElementById('cpb-product-preview'),
    productImage: document.getElementById('cpb-product-image'),
    productName: document.getElementById('cpb-product-name'),
    productMeta: document.getElementById('cpb-product-meta'),
    calWrap:  document.getElementById('cpb-calendar-wrap'),
    month:    document.getElementById('cpb-month'),
    days:     document.getElementById('cpb-days'),
    prev:     document.getElementById('cpb-prev'),
    next:     document.getElementById('cpb-next'),
    hint:     document.getElementById('cpb-range-hint'),
    errBox:   document.getElementById('cpb-error'),
    slots:    document.getElementById('cpb-slots'),
    pickup:   document.getElementById('cpb-pickup-slot'),
    ret:      document.getElementById('cpb-return-slot'),
    accessory: document.getElementById('cpb-accessory'),
    accessoryBundle: document.getElementById('cpb-accessory-bundle'),
    accessoryPrice: document.getElementById('cpb-accessory-price'),
    accessoryMedia: document.getElementById('cpb-accessory-media'),
    accessoryImagePrimary: document.getElementById('cpb-accessory-image-primary'),
    accessoryImageSecondary: document.getElementById('cpb-accessory-image-secondary'),
    accessoryTitleText: document.getElementById('cpb-accessory-title-text'),
    accessoryDescription: document.getElementById('cpb-accessory-description'),
    dogAccessory: document.getElementById('cpb-dog-accessory'),
    dogAccessoryCheckbox: document.getElementById('cpb-dog-accessory-checkbox'),
    contact:  document.getElementById('cpb-contact'),
    name:     document.getElementById('cpb-name'),
    email:    document.getElementById('cpb-email'),
    phone:    document.getElementById('cpb-phone'),
    vehicle:  document.getElementById('cpb-vehicle'),
    actions:  document.getElementById('cpb-actions'),
    check:    document.getElementById('cpb-check'),
    reset:    document.getElementById('cpb-reset'),
    result:   document.getElementById('cpb-result')
  };

  if (!els.root) return;

  var state = {
    products:        [],
    visibleProducts: [],
    locations:       [],
    selectedProduct: null,
    selectedLocation: null,
    calendarMonth:   monthStart(new Date()),
    calendarMap:     {},
    anchorDate:      '',
    selectedRange:   null,   // { start, end } — end may be ''
    selectedUnitRange: null,
    avail:           null,
    pricePreview:    null,
    accessoryBundleSelected: false,
    horntoolsAnnexSelected: false,
    dogAccessorySelected: false,
    loading:         false,
    depositAmount:   (initKaution != null && !isNaN(Number(initKaution)) && Number(initKaution) > 0) ? Number(initKaution) : null
  };

  var ANALYTICS_ENDPOINT = 'https://analytics.camping-pioneers.de/api/collect';
  var ANALYTICS_JOURNEY_KEY = 'cp_mietmanager_journey_id';
  var ANALYTICS_SESSION_KEY = 'cp_mietmanager_session_id';
  var contactStartedTracked = false;

  function analyticsRandomId(prefix) {
    if (window.crypto && window.crypto.randomUUID) return prefix + '_' + window.crypto.randomUUID();
    return prefix + '_' + Date.now() + '_' + Math.random().toString(36).slice(2);
  }

  function analyticsStorageGet(key) {
    try { return window.localStorage.getItem(key) || ''; } catch (e) { return ''; }
  }

  function analyticsStorageSet(key, value) {
    try { window.localStorage.setItem(key, value); } catch (e) {}
  }

  function analyticsId(key, prefix) {
    var current = analyticsStorageGet(key);
    if (current) return current;
    current = analyticsRandomId(prefix);
    analyticsStorageSet(key, current);
    return current;
  }

  function analyticsUtm(url) {
    return {
      source: url.searchParams.get('utm_source') || undefined,
      medium: url.searchParams.get('utm_medium') || undefined,
      campaign: url.searchParams.get('utm_campaign') || undefined,
      term: url.searchParams.get('utm_term') || undefined,
      content: url.searchParams.get('utm_content') || undefined
    };
  }

  function analyticsRental(extra) {
    var p = currentProduct();
    var l = currentLocation();
    var range = state.selectedRange || {};
    var payload = {
      rentalKind: RENTAL_KIND,
      productId: p && p.product_id,
      productTitle: p && p.title,
      variantId: p && p.variant_id,
      variantTitle: p && p.variant_title,
      locationId: l && Number(l.id),
      startDate: range.start || undefined,
      endDate: range.end || undefined,
      days: (state.avail && state.avail.days) || (state.pricePreview && state.pricePreview.days),
      price: (state.avail && state.avail.calculated_price) || (state.pricePreview && state.pricePreview.calculated_price)
    };
    extra = extra || {};
    Object.keys(extra).forEach(function(key) { payload[key] = extra[key]; });
    return payload;
  }

  function trackMietmanager(name, options) {
    try {
      options = options || {};
      var url = new URL(window.location.href);
      pushGtmConversion(name, options);
      var body = JSON.stringify({ events: [{
        name: name,
        property: 'mietmanager',
        timestamp: new Date().toISOString(),
        pixelVersion: 'mietmanager-liquid-1.1.0-fetch-verified',
        visitorId: analyticsId(ANALYTICS_JOURNEY_KEY, 'mmj'),
        journeyId: analyticsId(ANALYTICS_JOURNEY_KEY, 'mmj'),
        sessionId: analyticsId(ANALYTICS_SESSION_KEY, 'mms'),
        consent: { analytics: true },
        utm: analyticsUtm(url),
        page: { url: url.toString(), referrer: document.referrer || undefined, title: document.title || undefined },
        target: options.targetLabel ? { label: options.targetLabel } : undefined,
        rental: options.rental || analyticsRental(),
        raw: options.raw
      }] });
      fetch(ANALYTICS_ENDPOINT, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: body, keepalive: true, mode: 'cors' })
        .then(function(response) { if (!response.ok) throw new Error('collector ' + response.status); })
        .catch(function() {
          try { if (navigator.sendBeacon) navigator.sendBeacon(ANALYTICS_ENDPOINT, new Blob([body], { type: 'application/json' })); } catch (e) {}
        });
    } catch (e) {}
  }

  function pushGtmConversion(name, options) {
    var conversion = null;
    if (name === 'rental_availability_checked') {
      conversion = { event: 'cp_rental_booking_step', conversionId: '398604311', conversionLabel: 'd9FMCI_dv6kcEJfwiL4B', conversionCategory: 'rental_booking' };
    } else if (name === 'rental_booking_requested') {
      conversion = { event: 'cp_rental_booking_created', conversionId: '398604311', conversionLabel: 'd9FMCI_dv6kcEJfwiL4B', conversionCategory: 'rental_booking' };
    }
    if (!conversion) return;
    var rental = (options && options.rental) || analyticsRental();
    conversion.rentalKind = rental.rentalKind;
    conversion.productId = rental.productId;
    conversion.variantId = rental.variantId;
    conversion.locationId = rental.locationId;
    conversion.value = rental.price;
    conversion.currency = rental.price ? 'EUR' : undefined;
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push(conversion);
  }

  /* ── Utilities ── */
  function pad2(n) { return String(n).padStart(2, '0'); }
  function ymd(d) { return d.getFullYear() + '-' + pad2(d.getMonth() + 1) + '-' + pad2(d.getDate()); }
  function parseYmd(v) { return new Date(v + 'T00:00:00'); }
  function addDays(iso, days) { var d = parseYmd(iso); d.setDate(d.getDate() + days); return ymd(d); }
  function monthStart(d) { return new Date(d.getFullYear(), d.getMonth(), 1); }
  function mondayFirstOffset(year, month) {
    var sundayFirst = new Date(Date.UTC(year, month, 1)).getUTCDay();
    return (sundayFirst + 6) % 7;
  }
  function monthLabel(d) { return d.toLocaleDateString('de-DE', { month: 'long', year: 'numeric' }); }
  function fmtDate(iso) { return parseYmd(iso).toLocaleDateString('de-DE', { day: '2-digit', month: '2-digit', year: 'numeric' }); }
  function esc(v) {
    return String(v == null ? '' : v).replace(/[&<>"']/g, function(c) {
      return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c];
    });
  }
  function showError(msg) {
    if (!msg) { els.errBox.style.display = 'none'; els.errBox.textContent = ''; return; }
    els.errBox.textContent = msg;
    els.errBox.style.display = '';
  }

  function markInvalid(el, invalid) {
    if (!el) return;
    if (invalid) el.setAttribute('aria-invalid', 'true');
    else el.removeAttribute('aria-invalid');
  }

  function showFieldError(msg, el) {
    showError(msg);
    if (els.errBox.scrollIntoView) els.errBox.scrollIntoView({ block: 'center', behavior: 'smooth' });
    if (el && el.focus) el.focus();
  }

  /* ── API ── */
  async function api(path, options) {
    var res = await fetch(API_BASE + path, options || {});
    if (!res.ok) throw new Error('HTTP ' + res.status);
    return res.json();
  }

  /* ── Select helpers ── */
  function renderSelectOptions(selectEl, list, labelFn, valueFn) {
    selectEl.innerHTML = '';
    list.forEach(function(item, i) {
      var o = document.createElement('option');
      o.value = valueFn(item, i);
      o.textContent = labelFn(item, i);
      selectEl.appendChild(o);
    });
  }

  function currentProduct() {
    return state.visibleProducts.find(function(p) { return (p.product_id + '|' + p.variant_id) === els.product.value; }) || null;
  }
  function currentLocation() {
    return state.locations.find(function(l) { return String(l.id) === els.location.value; }) || null;
  }

  function supportsAccessoryBundle(product) {
    if (!product) return false;
    if (product.supports_roof_tent_accessory_bundle === true) return true;
    return String(product.vendor || '').trim().toLowerCase() === 'qeedo';
  }

  function isHorntoolsProduct(product) {
    return !!product && String(product.vendor || '').trim().toLowerCase() === 'horntools';
  }

  function supportsHorntoolsAnnex(product) {
    if (!isHorntoolsProduct(product)) return false;
    var code = String(product.model_code || '').toUpperCase();
    return code.indexOf('_OHNE_VORZELT') >= 0 || /\bohne vorzelt\b/i.test(String(product.variant_title || ''));
  }

  function setAccessoryPresentation(kind, product) {
    if (kind === 'horntools') {
      if (els.accessoryTitleText) els.accessoryTitleText.textContent = 'Passendes Horntools Vorzelt mitnehmen';
      if (els.accessoryDescription) {
        els.accessoryDescription.textContent = 'Mehr geschützter Raum direkt am Dachzelt: Das passende Horntools Vorzelt wird automatisch für Größe und Farbe deines gewählten Zelts ausgewählt. Der Aufpreis richtet sich nach deinem Mietzeitraum.';
      }
      if (els.accessoryImagePrimary) {
        els.accessoryImagePrimary.src = (product && product.product_image_url) || '';
        els.accessoryImagePrimary.style.display = '';
      }
      if (els.accessoryImageSecondary) els.accessoryImageSecondary.style.display = 'none';
      if (els.accessoryMedia) els.accessoryMedia.style.gridTemplateColumns = '1fr';
      return;
    }
    if (els.accessoryTitleText) els.accessoryTitleText.textContent = 'Vorzelt + Verbindungsschleuse mitnehmen';
    if (els.accessoryDescription) {
      els.accessoryDescription.textContent = 'Mehr geschützter Raum am Stellplatz: Quick Base als freistehendes Vorzelt plus passende Schleuse zum Dachzelt. Der Aufpreis richtet sich automatisch nach deinem Mietzeitraum.';
    }
    if (els.accessoryImagePrimary) {
      els.accessoryImagePrimary.src = QEEDO_ACCESSORY_IMAGE_PRIMARY;
      els.accessoryImagePrimary.style.display = '';
    }
    if (els.accessoryImageSecondary) {
      els.accessoryImageSecondary.src = QEEDO_ACCESSORY_IMAGE_SECONDARY;
      els.accessoryImageSecondary.style.display = '';
    }
    if (els.accessoryMedia) els.accessoryMedia.style.gridTemplateColumns = '';
  }

  function selectedAccessories() {
    var selected = [];
    if (state.accessoryBundleSelected && supportsAccessoryBundle(currentProduct())) selected.push(ACCESSORY_BUNDLE_CODE);
    if (state.horntoolsAnnexSelected && supportsHorntoolsAnnex(currentProduct())) selected.push(HORNTOOLS_ANNEX_CODE);
    if (state.dogAccessorySelected && currentProduct()) selected.push(DOG_ACCESSORY_CODE);
    return selected;
  }

  function updateProductPreview() {
    if (!els.productPreview) return;
    var p = currentProduct();
    var l = currentLocation();
    if (!p) {
      els.productPreview.style.display = 'none';
      return;
    }
    var imageUrl = p.product_image_url || '';
    if (els.productImage) {
      if (imageUrl) {
        els.productImage.src = imageUrl;
        els.productImage.alt = p.title || 'Dachzelt';
        els.productImage.style.display = '';
      } else {
        els.productImage.removeAttribute('src');
        els.productImage.alt = '';
        els.productImage.style.display = 'none';
      }
    }
    if (els.productName) {
      els.productName.textContent = p.title + (p.variant_title && p.variant_title !== 'Default Title' ? ' / ' + p.variant_title : '');
    }
    if (els.productMeta) {
      els.productMeta.textContent = (l ? 'Abholort: ' + l.name + '. ' : '') + 'Das Bild zeigt das aktuell ausgewählte Dachzelt aus dem Dropdown.';
    }
    els.productPreview.style.display = 'block';
  }

  function updateAccessoryDisplay(pricing) {
    if (!els.accessory) return;
    var product = currentProduct();
    var isQeedoAccessory = supportsAccessoryBundle(product);
    var isHorntoolsAccessory = supportsHorntoolsAnnex(product);
    var show = !!((isQeedoAccessory || isHorntoolsAccessory) && state.selectedRange && state.selectedRange.start && state.selectedRange.end);
    els.accessory.style.display = show ? '' : 'none';
    if (!show) {
      state.accessoryBundleSelected = false;
      state.horntoolsAnnexSelected = false;
      if (els.accessoryBundle) els.accessoryBundle.checked = false;
    } else if (isHorntoolsAccessory) {
      state.accessoryBundleSelected = false;
      setAccessoryPresentation('horntools', product);
      if (els.accessoryBundle) els.accessoryBundle.checked = state.horntoolsAnnexSelected;
    } else {
      state.horntoolsAnnexSelected = false;
      setAccessoryPresentation('qeedo', product);
      if (els.accessoryBundle) els.accessoryBundle.checked = state.accessoryBundleSelected;
    }
    if (els.accessoryPrice) {
      var price = pricing && pricing.accessory_price_total ? Number(pricing.accessory_price_total) : 0;
      var bundlePrice = state.dogAccessorySelected ? Math.max(0, price - DOG_ACCESSORY_PRICE) : price;
      var bundleSelected = state.accessoryBundleSelected || state.horntoolsAnnexSelected;
      els.accessoryPrice.textContent = bundleSelected && bundlePrice > 0 ? '+' + bundlePrice + '\u00A0€' : '';
    }
    if (els.dogAccessory) {
      var showDog = !!(currentProduct() && state.selectedRange && state.selectedRange.start && state.selectedRange.end);
      els.dogAccessory.style.display = showDog ? '' : 'none';
      if (!showDog) {
        state.dogAccessorySelected = false;
        if (els.dogAccessoryCheckbox) els.dogAccessoryCheckbox.checked = false;
      }
    }
  }

  function productsForLocation(locationId) {
    var lid = Number(locationId);
    return state.products.filter(function(p) {
      if (!Array.isArray(p.future_location_ids) || !p.future_location_ids.length) return false;
      return p.future_location_ids.indexOf(lid) >= 0;
    });
  }

  function syncSelectedProductMeta() {
    state.selectedProduct = currentProduct();
    var p = state.selectedProduct;
    if (p && p.deposit_amount != null && !isNaN(Number(p.deposit_amount)) && Number(p.deposit_amount) > 0) {
      state.depositAmount = Number(p.deposit_amount);
      updateProductPreview();
      return;
    }
    state.depositAmount = (initKaution != null && !isNaN(Number(initKaution)) && Number(initKaution) > 0) ? Number(initKaution) : null;
    updateProductPreview();
  }

  function refreshProductsForLocation() {
    var loc = currentLocation();
    var prevValue = els.product.value;
    state.visibleProducts = loc ? productsForLocation(loc.id) : [];
    els.product.innerHTML = '';
    if (!state.visibleProducts.length) {
      var emptyOpt = document.createElement('option');
      emptyOpt.value = '';
      emptyOpt.textContent = 'Keine Mietprodukte mit Zukunftsbestand';
      els.product.appendChild(emptyOpt);
      els.product.disabled = true;
      state.selectedProduct = null;
      updateProductPreview();
      return;
    }
    els.product.disabled = false;
    renderSelectOptions(
      els.product,
      state.visibleProducts,
      function(p) {
        return p.title + (p.variant_title && p.variant_title !== 'Default Title' ? ' – ' + p.variant_title : '');
      },
      function(p) { return p.product_id + '|' + p.variant_id; }
    );
    if (prevValue && state.visibleProducts.some(function(p) { return (p.product_id + '|' + p.variant_id) === prevValue; })) {
      els.product.value = prevValue;
    }
    syncSelectedProductMeta();
  }

  /* ── Bootstrap ── */
  async function loadBootstrap() {
    var qs = new URLSearchParams();
    qs.set('kind', RENTAL_KIND);
    if (initProductId) qs.set('product_id', String(initProductId));
    if (initVariantId) qs.set('variant_id', String(initVariantId));
    var data = await api('/bootstrap?' + qs.toString());

    state.products  = data.products  || [];
    state.locations = data.locations || [];

    if (!state.products.length || !state.locations.length) {
      throw new Error('Keine Mietprodukte oder Standorte verfügbar');
    }

    renderSelectOptions(
      els.location,
      state.locations,
      function(l) { return l.name; },
      function(l) { return String(l.id); }
    );

    state.selectedLocation = currentLocation();
    refreshProductsForLocation();
    var initial = state.visibleProducts.find(function(p) {
      return String(p.product_id) === String(initProductId || '') && String(p.variant_id) === String(initVariantId || '');
    });
    if (initial) els.product.value = initial.product_id + '|' + initial.variant_id;
    syncSelectedProductMeta();

    els.calWrap.style.display = '';
    if (!state.selectedProduct) {
      showError('Für den gewählten Standort ist aktuell kein Mietprodukt mit Zukunftsbestand verfügbar.');
      hideSlotAndContact();
      return;
    }
    await loadCalendar();
    trackMietmanager('rental_widget_viewed', {
      raw: {
        shop: SHOP_DOMAIN,
        pagePath: PAGE_PATH,
        hasProductContext: !!(initProductId || initVariantId)
      }
    });
  }

  /* ── Calendar load ── */
  async function loadCalendar() {
    state.selectedProduct  = currentProduct();
    state.selectedLocation = currentLocation();
    if (!state.selectedProduct || !state.selectedLocation) {
      state.calendarMap = {};
      renderCalendar();
      return;
    }

    var from   = ymd(monthStart(state.calendarMonth));
    var to     = addDays(from, 119);
    var params = new URLSearchParams({
      location_id: String(state.selectedLocation.id),
      product_id:  state.selectedProduct.product_id,
      variant_id:  state.selectedProduct.variant_id,
      from: from,
      to:   to
    });
    if (state.anchorDate) params.set('selected_date', state.anchorDate);

    var res = await api('/availability/calendar?' + params.toString());
    state.calendarMap = {};
    (res.dates || []).forEach(function(d) { state.calendarMap[d.date] = d; });
    state.selectedUnitRange = res.selected_unit_range || null;
    renderCalendar();
  }

  /* ── Calendar render (Airbnb-style) ── */
  function renderCalendar() {
    var year   = state.calendarMonth.getFullYear();
    var month  = state.calendarMonth.getMonth();
    var last   = new Date(year, month + 1, 0).getDate();
    var offset = mondayFirstOffset(year, month);

    els.month.textContent = monthLabel(state.calendarMonth);
    els.days.innerHTML    = '';

    var hasRange  = !!(state.selectedRange && state.selectedRange.start && state.selectedRange.end);
    var hasAnchor = !!state.anchorDate && !hasRange;
    var todayKey  = ymd(new Date());

    for (var dayNum = 1; dayNum <= last; dayNum++) {
      var d   = new Date(year, month, dayNum);
      var key = ymd(d);
      var info      = state.calendarMap[key];
      var isPast    = key < todayKey;
      var available = !isPast && !!(info && (info.handover_available != null ? info.handover_available : info.is_available));
      var inUnit    = !!(state.anchorDate && info && info.in_selected_unit_range);

      var isAnchor   = hasAnchor && key === state.anchorDate;
      var isSelStart = hasRange  && key === state.selectedRange.start;
      var isSelEnd   = hasRange  && key === state.selectedRange.end;
      var isInRange  = hasRange  && key > state.selectedRange.start && key < state.selectedRange.end;

      /* Label inside circle */
      var circleLabel = '';
      if (isAnchor || isSelStart) circleLabel = 'Abholung';
      else if (isSelEnd) circleLabel = 'Rückgabe';
      else if (isInRange) circleLabel = '';
      else if (isPast) circleLabel = '';
      else if (available) circleLabel = 'frei';
      else circleLabel = '';

      /* Build class list */
      var cls = 'cpb-day';
      if (isPast) cls += ' past';
      else if (available) cls += ' ok';
      else cls += ' no';
      if (isAnchor)   cls += ' anchor';
      if (isSelStart) cls += ' sel-start';
      if (isSelEnd)   cls += ' sel-end';
      if (isInRange)  cls += ' in-range';

      var btn = document.createElement('button');
      btn.type      = 'button';
      btn.className = cls;
      if (isPast || !available) btn.disabled = true;
      if (dayNum === 1) btn.style.gridColumnStart = String(offset + 1);

      /* Bar span */
      var bar = document.createElement('span');
      bar.className = 'cpb-bar';

      /* Circle span */
      var circle = document.createElement('span');
      circle.className = 'cpb-circle';
      circle.innerHTML =
        '<span class="d">' + dayNum + '</span>' +
        '<span class="s">' + esc(circleLabel) + '</span>';

      btn.appendChild(bar);
      btn.appendChild(circle);

      if (!isPast && available) {
        btn.addEventListener('click', (function(k) {
          return function() { pickDate(k); };
        })(key));
      }

      els.days.appendChild(btn);
    }

    /* Update hint text */
    if (hasAnchor) {
      els.hint.textContent = 'Abholung: ' + fmtDate(state.anchorDate) + ' — wähle jetzt das Rückgabedatum.';
    } else if (hasRange) {
      els.hint.textContent = 'Zeitraum: ' + fmtDate(state.selectedRange.start) + ' bis ' + fmtDate(state.selectedRange.end) + '.';
    } else {
      els.hint.textContent = 'Klicke zuerst auf das Abholdatum, dann auf das Rückgabedatum.';
    }
  }

  /* ── Date pick logic ── */
  async function pickDate(key) {
    showError('');
    state.avail = null;
    showResult('');

    /* Case 1: No anchor yet (or range already complete → start over) */
    if (!state.anchorDate || (state.selectedRange && state.selectedRange.start && state.selectedRange.end)) {
      state.anchorDate    = key;
      state.selectedRange = { start: key, end: '' };
      /* SYNCHRONOUS render first — gives instant blue circle */
      renderCalendar();
      /* Then load API in background to get unit-range info */
      loadCalendar().catch(function() {});
      hideSlotAndContact();
      return;
    }

    /* Case 2: Click same day as anchor → deselect */
    if (key === state.anchorDate) {
      state.anchorDate      = '';
      state.selectedRange   = null;
      state.selectedUnitRange = null;
      renderCalendar();
      hideSlotAndContact();
      return;
    }

    /* Case 3: Second click → finalize range */
    var start = key < state.anchorDate ? key : state.anchorDate;
    var end   = key < state.anchorDate ? state.anchorDate : key;
    state.selectedRange = { start: start, end: end };
    /* SYNCHRONOUS render for immediate range highlight */
    renderCalendar();
    /* Load slots asynchronously */
    await loadSlots();
    trackMietmanager('rental_date_selected');
  }

  function hideSlotAndContact() {
    els.slots.style.display   = 'none';
    if (els.accessory) els.accessory.style.display = 'none';
    if (els.dogAccessory) els.dogAccessory.style.display = 'none';
    els.contact.style.display = 'none';
    els.actions.style.display = 'none';
  }

  function hideContactOnly() {
    els.contact.style.display = 'none';
    markInvalid(els.name, false);
    markInvalid(els.email, false);
    markInvalid(els.phone, false);
  }

  function contactVisible() {
    return els.contact.style.display !== 'none';
  }

  function showBookingForm() {
    els.contact.style.display = '';
    if (els.contact.scrollIntoView) els.contact.scrollIntoView({ block: 'center', behavior: 'smooth' });
    if (els.name && els.name.focus) els.name.focus();
  }

  /* ── Slot loading ── */
  function setSlotOptions(selectEl, slots) {
    selectEl.innerHTML = '';
    if (!slots || !slots.length) {
      var o = document.createElement('option');
      o.value = '';
      o.textContent = 'Keine Slots verfügbar';
      selectEl.appendChild(o);
      return;
    }
    slots.forEach(function(s) {
      var o = document.createElement('option');
      o.value = s.slot;
      o.textContent = s.slot;
      selectEl.appendChild(o);
    });
  }

  async function loadSlots() {
    if (!state.selectedRange || !state.selectedRange.start || !state.selectedRange.end) return;
    var p = currentProduct();
    var l = currentLocation();
    if (!p || !l) return;

    var base = new URLSearchParams({
      location_id: String(l.id),
      product_id:  p.product_id,
      variant_id:  p.variant_id
    });

    var pickupParams = new URLSearchParams(base);
    pickupParams.set('date', state.selectedRange.start);
    pickupParams.set('kind', 'pickup');

    var returnParams = new URLSearchParams(base);
    returnParams.set('date', state.selectedRange.end);
    returnParams.set('kind', 'return');

    var [pickupRes, returnRes] = await Promise.all([
      api('/slots?' + pickupParams.toString()),
      api('/slots?' + returnParams.toString())
    ]);

    setSlotOptions(els.pickup, pickupRes.slots || []);
    setSlotOptions(els.ret,    returnRes.slots || []);

    els.slots.style.display   = '';
    updateAccessoryDisplay();
    hideContactOnly();
    els.actions.style.display = '';
    updatePricePreview().catch(function() {
      showResult('<p>Der Mietpreis konnte gerade nicht berechnet werden. Bitte prüfe deine Auswahl noch einmal.</p>');
    });
  }

  /* ── Result display ── */
  function pricingText(pricing, product, availabilityKnown) {
    var totalFee = Number(pricing.calculated_price || 0);
    var baseFee = Number(pricing.base_calculated_price || totalFee);
    var accessoryTotal = Number(pricing.accessory_price_total || 0);
    var securityDeposit = Number(pricing.security_deposit || 0);
    var buyBonus50 = Number(pricing.buy_bonus_50 || Math.round(baseFee * 0.5));
    var buyText = product && product.can_buy_after_rent
      ? '<p style="margin-top:10px;">Wenn du dich nach der Miete für den Kauf des Dachzelts entscheidest, rechnen wir dir <b>' + esc(buyBonus50 || 0) + '\u00A0€</b> auf den Kaufpreis an.</p>'
      : '';
    var qeedoBundleSelected = state.accessoryBundleSelected && supportsAccessoryBundle(product);
    var horntoolsBundleSelected = state.horntoolsAnnexSelected && supportsHorntoolsAnnex(product);
    var bundleSelected = qeedoBundleSelected || horntoolsBundleSelected;
    var dogSelected = state.dogAccessorySelected && product;
    var bundleTotal = bundleSelected ? Math.max(0, accessoryTotal - (dogSelected ? DOG_ACCESSORY_PRICE : 0)) : 0;
    var bundleTitle = horntoolsBundleSelected ? 'passendes Horntools Vorzelt' : 'Quick Base Vorzelt + Verbindungsschleuse';
    var accessoryText = bundleTotal > 0
      ? '<p style="margin-top:10px;">Mit dabei: <b>' + esc(bundleTitle) + '</b> für <b>' + esc(bundleTotal) + '\u00A0€</b>. Die reine Dachzeltmiete beträgt <b>' + esc(baseFee) + '\u00A0€</b>.</p>'
      : '';
    var dogText = dogSelected
      ? '<p style="margin-top:10px;">Die <b>Hundemitnahme</b> ist für <b>' + esc(DOG_ACCESSORY_PRICE) + '\u00A0€</b> als einmalige Kostenposition enthalten.</p>'
      : '';
    var intro = availabilityKnown
      ? 'Deine Mietanfrage für das gewählte Dachzelt'
      : 'Dein Mietpreis für das gewählte Dachzelt';
    var suffix = availabilityKnown
      ? 'liegt bei'
      : 'beträgt';
    var availabilityNote = availabilityKnown
      ? ''
      : '<p style="margin-top:10px;">Wähle nun noch Abhol- und Rückgabezeit und prüfe danach die Verfügbarkeit.</p>';
    return (
      '<p>' + intro + ' (<b>' + esc(product ? product.title : '') + '</b>) für <b>' + esc(pricing.days) + '</b> Tage ' + suffix + ' <b>' + esc(totalFee) + '\u00A0€</b>. Einweisung und Montage sind bereits enthalten.</p>' +
      accessoryText +
      dogText +
      '<p style="margin-top:10px;">Zusätzlich fällt eine Kaution von <b>' + esc((state.depositAmount != null && Number(state.depositAmount) > 0) ? state.depositAmount : securityDeposit) + '\u00A0€</b> an. Bitte bring die Kaution zur Abholung in bar mit.</p>' +
      buyText +
      availabilityNote
    );
  }

  function showResult(html) {
    if (!html) {
      els.result.style.display = 'none';
      els.result.innerHTML     = '';
      return;
    }
    els.result.style.display = '';
    els.result.innerHTML     = html;

    if (state.avail && state.avail.is_bookable) {
      var cta = document.createElement('div');
      cta.style.marginTop = '14px';
      var btn = document.createElement('button');
      btn.type      = 'button';
      btn.className = 'cpb-btn primary';
      btn.textContent = 'Buchung anfragen';
      btn.addEventListener('click', function() {
        if (!contactVisible()) {
          showBookingForm();
          btn.textContent = 'Anfrage senden';
          return;
        }
        submitBooking().catch(function() {
          showResult('<p>Sorry – das Absenden hat leider nicht geklappt. Bitte versuche es erneut.</p>');
        });
      });
      cta.appendChild(btn);
      els.result.appendChild(cta);
    }
  }

  /* ── Validation ── */
  function validateContactForm() {
    var name  = (els.name.value  || '').trim();
    var email = (els.email.value || '').trim();
    var phone = (els.phone.value || '').trim();
    markInvalid(els.name, false);
    markInvalid(els.email, false);
    markInvalid(els.phone, false);
    if (!name) {
      markInvalid(els.name, true);
      showFieldError('Bitte gib deinen Namen ein.', els.name);
      return false;
    }
    if (!email && !phone) {
      markInvalid(els.email, true);
      markInvalid(els.phone, true);
      showFieldError('Bitte gib eine E-Mail-Adresse oder Telefonnummer an.', els.email);
      return false;
    }
    if (email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      markInvalid(els.email, true);
      showFieldError('Bitte gib eine gültige E-Mail-Adresse ein oder lass das Feld leer und nutze Telefon.', els.email);
      return false;
    }
    showError('');
    return true;
  }

  function validateRequiredSelection() {
    var p = currentProduct();
    var l = currentLocation();
    if (!p) { showError('Bitte wähle ein Mietprodukt.'); return false; }
    if (!l) { showError('Bitte wähle einen Standort.'); return false; }
    if (!state.selectedRange || !state.selectedRange.start || !state.selectedRange.end) {
      showError('Bitte wähle zuerst Abhol- und Rückgabedatum im Kalender.');
      return false;
    }
    if (!els.pickup.value || !els.ret.value) {
      showError('Bitte wähle Abhol- und Rückgabe-Slot.');
      return false;
    }
    showError('');
    return true;
  }

  /* ── Availability check payload ── */
  function buildCheckPayload() {
    var p = currentProduct();
    var l = currentLocation();
    if (!p || !l || !state.selectedRange || !state.selectedRange.start || !state.selectedRange.end) return null;
    var payload = {
      product_id:  p.product_id,
      variant_id:  p.variant_id,
      location_id: Number(l.id),
      start_date:  state.selectedRange.start,
      end_date:    state.selectedRange.end,
      pickup_slot: els.pickup.value,
      return_slot: els.ret.value,
      selected_accessories: selectedAccessories()
    };
    if (state.depositAmount != null && Number(state.depositAmount) > 0) payload.deposit_amount = Number(state.depositAmount);
    return payload;
  }

  function buildPricingPayload() {
    var p = currentProduct();
    if (!p || !state.selectedRange || !state.selectedRange.start || !state.selectedRange.end) return null;
    var payload = {
      product_id: p.product_id,
      variant_id: p.variant_id,
      start_date: state.selectedRange.start,
      end_date: state.selectedRange.end,
      selected_accessories: selectedAccessories()
    };
    if (state.depositAmount != null && Number(state.depositAmount) > 0) payload.deposit_amount = Number(state.depositAmount);
    return payload;
  }

  async function updatePricePreview() {
    var payload = buildPricingPayload();
    if (!payload) return;
    var preview = await api('/pricing/preview', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });
    state.pricePreview = preview;
    state.avail = null;
    updateAccessoryDisplay(preview);
    showResult(pricingText(preview, currentProduct(), false));
  }

  async function checkAvailability() {
    if (!validateRequiredSelection()) return;
    var payload = buildCheckPayload();
    if (!payload) { showError('Bitte prüfe deine Angaben.'); return; }

    showResult('<p>Verfügbarkeit wird geprüft …</p>');
    var avail = await api('/availability/check', {
      method:  'POST',
      headers: { 'Content-Type': 'application/json' },
      body:    JSON.stringify(payload)
    });
    state.avail = avail;
    state.pricePreview = avail;
    updateAccessoryDisplay(avail);
    trackMietmanager('rental_availability_checked', {
      rental: analyticsRental({
        days: avail.days,
        price: avail.calculated_price,
        bookable: !!avail.is_bookable
      })
    });

    if (!avail.is_bookable) {
      showResult('<p>Leider ist das Dachzelt für diesen Zeitraum nicht verfügbar. Bitte wähle andere Daten.</p>');
      return;
    }

    hideContactOnly();
    showResult(pricingText(avail, currentProduct(), true));
  }

  async function submitBooking() {
    if (!validateRequiredSelection()) return;
    if (!contactVisible()) {
      showBookingForm();
      return;
    }
    if (!validateContactForm()) return;
    var payload = buildCheckPayload();
    if (!payload) { showError('Bitte prüfe deine Angaben.'); return; }

    payload.customer = {
      name:    (els.name.value    || '').trim(),
      email:   (els.email.value   || '').trim(),
      phone:   (els.phone.value   || '').trim(),
      vehicle: (els.vehicle.value || '').trim()
    };

    showResult('<p>Anfrage wird gesendet …</p>');
    var res = await api('/bookings', {
      method:  'POST',
      headers: { 'Content-Type': 'application/json' },
      body:    JSON.stringify(payload)
    });

    state.avail = null;
    state.pricePreview = null;
    trackMietmanager('rental_booking_requested', {
      rental: analyticsRental({
        days: res.booking.days,
        price: res.booking.calculated_price,
        bookable: true
      })
    });
    showResult(
      '<p><b>Danke für deine Anfrage!</b> Hier sind deine Details:</p>' +
      '<p>Referenz: <b>' + esc(res.booking.external_ref) + '</b><br>' +
      'Zeitraum: <b>' + esc(fmtDate(res.booking.start_date)) + ' bis ' + esc(fmtDate(res.booking.end_date)) + '</b></p>' +
      '<p>Wir kümmern uns jetzt um die Prüfung und melden uns schnell bei dir. Du wirst automatisch benachrichtigt, sobald wir die Buchung bestätigt haben.</p>'
    );
  }

  /* ── Reset ── */
  function resetAll() {
    state.anchorDate       = '';
    state.selectedRange    = null;
    state.selectedUnitRange = null;
    state.avail            = null;
    state.pricePreview     = null;
    state.accessoryBundleSelected = false;
    state.horntoolsAnnexSelected = false;
    state.dogAccessorySelected = false;
    if (els.accessoryBundle) els.accessoryBundle.checked = false;
    if (els.dogAccessoryCheckbox) els.dogAccessoryCheckbox.checked = false;
    showError('');
    markInvalid(els.name, false);
    markInvalid(els.email, false);
    markInvalid(els.phone, false);
    showResult('');
    hideSlotAndContact();
    syncSelectedProductMeta();
    loadCalendar().catch(function() {});
  }

  /* ── Event bindings ── */
  els.prev.addEventListener('click', function() {
    state.calendarMonth = new Date(state.calendarMonth.getFullYear(), state.calendarMonth.getMonth() - 1, 1);
    loadCalendar().catch(function() {});
  });
  els.next.addEventListener('click', function() {
    state.calendarMonth = new Date(state.calendarMonth.getFullYear(), state.calendarMonth.getMonth() + 1, 1);
    loadCalendar().catch(function() {});
  });
  els.product.addEventListener('change', function() {
    syncSelectedProductMeta();
    trackMietmanager('rental_product_selected');
    resetAll();
  });
  els.location.addEventListener('change', function() {
    refreshProductsForLocation();
    syncSelectedProductMeta();
    trackMietmanager('rental_product_selected');
    resetAll();
  });
  els.check.addEventListener('click', function() {
    checkAvailability().catch(function() {
      showResult('<p>Sorry – die Verfügbarkeit konnte nicht geprüft werden. Bitte versuche es erneut.</p>');
    });
  });
  els.reset.addEventListener('click', resetAll);
  if (els.accessoryBundle) {
    els.accessoryBundle.addEventListener('change', function() {
      var selected = !!els.accessoryBundle.checked;
      state.horntoolsAnnexSelected = supportsHorntoolsAnnex(currentProduct()) && selected;
      state.accessoryBundleSelected = !state.horntoolsAnnexSelected && selected;
      state.avail = null;
      updatePricePreview().catch(function() {
        updateAccessoryDisplay();
        showResult('<p>Der Mietpreis konnte gerade nicht berechnet werden. Bitte prüfe deine Auswahl noch einmal.</p>');
      });
    });
  }
  if (els.dogAccessoryCheckbox) {
    els.dogAccessoryCheckbox.addEventListener('change', function() {
      state.dogAccessorySelected = !!els.dogAccessoryCheckbox.checked;
      state.avail = null;
      updatePricePreview().catch(function() {
        updateAccessoryDisplay();
        showResult('<p>Der Mietpreis konnte gerade nicht berechnet werden. Bitte prüfe deine Auswahl noch einmal.</p>');
      });
    });
  }
  [els.name, els.email, els.phone].forEach(function(el) {
    el.addEventListener('input', function() {
      if (!contactStartedTracked) {
        contactStartedTracked = true;
        trackMietmanager('rental_contact_started');
      }
      if (el === els.email || el === els.phone) {
        markInvalid(els.email, false);
        markInvalid(els.phone, false);
        return;
      }
      markInvalid(el, false);
    });
  });

  /* ── Boot ── */
  loadBootstrap().catch(function(err) {
    showResult('<p>Sorry – das Laden der Buchungsdaten hat leider nicht geklappt (' + esc(err && err.message || '') + ').</p>');
  });
})();
</script>

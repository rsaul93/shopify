    "faq_UVdYWy": {
      "type": "faq",
      "blocks": {
        "question_DHkBCV": {
          "type": "question",
          "settings": {
            "title": "Wie kann ich den KFZ-Transportanhänger mieten?",
            "text": "<p>Wähle den gewünschten Zeitraum im Mietpreisrechner und sende anschließend deine Anfrage. Wir prüfen die Verfügbarkeit und melden uns schnellstmöglich bei dir.</p>",
            "enable_highlight": false,
            "highlight_style": "marker"
          }
        },
        "question_dzTFmC": {
          "type": "question",
          "settings": {
            "title": "Wie schnell erhalte ich eine Rückmeldung?",
            "text": "<p>In der Regel erhältst du innerhalb kurzer Zeit eine Rückmeldung von uns. Wir informieren dich über die Verfügbarkeit und alle weiteren Schritte.</p>",
            "enable_highlight": false,
            "highlight_style": "marker"
          }
        },
        "question_kWcE8C": {
          "type": "question",
          "settings": {
            "title": "Wie erfolgt die Bezahlung?",
            "text": "<p>Du kannst bequem per <strong>Barzahlung, EC-Karte, PayPal oder Überweisung</strong> bezahlen. Alle Zahlungsdetails erhältst du vorab mit deiner Buchungsbestätigung. Die Bezahlung erfolgt in der Regel bei Abholung des Anhängers.</p>",
            "enable_highlight": false,
            "highlight_style": "marker"
          }
        },
        "question_JjDirE": {
          "type": "question",
          "settings": {
            "title": "Wie hoch ist die Kaution?",
            "text": "<p>Die Kaution für den Besttrailers KFZ-Transportanhänger beträgt <strong>500 €</strong>. Sie wird bei Abholung hinterlegt und nach ordnungsgemäßer, besenreiner Rückgabe vollständig zurückgezahlt.</p>",
            "enable_highlight": false,
            "highlight_style": "marker"
          }
        },
        "question_kydfXK": {
          "type": "question",
          "settings": {
            "title": "In welcher Ausstattung wird der Anhänger vermietet?",
            "text": "<p>Der Besttrailers KFZ-Transportanhänger wird mit manueller Seilwinde und integrierten Auffahrrampen vermietet. Passende Spanngurte kannst du bei der Anfrage ergänzen. Bei der Übergabe erhältst du eine persönliche Einweisung.</p>",
            "enable_highlight": false,
            "highlight_style": "marker"
          }
        },
        "question_9KMXaL": {
          "type": "question",
          "settings": {
            "title": "Wo kann ich den Anhänger abholen?",
            "text": "<p>Der Besttrailers KFZ-Transportanhänger kann ausschließlich in Pettstadt bei Bamberg abgeholt werden. Die genaue Adresse und alle Details erhältst du mit der Buchungsbestätigung.</p>",
            "enable_highlight": false,
            "highlight_style": "marker"
          }
        },
        "question_qtMPtL": {
          "type": "question",
          "settings": {
            "title": "Ist eine Einweisung bei der Abholung dabei?",
            "text": "<p>Ja, bei der Abholung erhältst du eine persönliche Einweisung. Wir erklären dir alles Wichtige zur sicheren Nutzung des Anhängers.</p>",
            "enable_highlight": false,
            "highlight_style": "marker"
          }
        },
        "question_t3qKpp": {
          "type": "question",
          "settings": {
            "title": "Was ist bei der Rückgabe des Anhängers zu beachten?",
            "text": "<p>Der Anhänger sollte <strong>besenrein und in ordnungsgemäßem Zustand</strong> zurückgegeben werden. Normale Gebrauchsspuren durch die Nutzung sind selbstverständlich kein Problem.</p>",
            "enable_highlight": false,
            "highlight_style": "marker"
          }
        },
        "question_JcJQE7": {
          "type": "question",
          "settings": {
            "title": "Welche Voraussetzungen muss mein Fahrzeug erfüllen?",
            "text": "<p>Dein Zugfahrzeug benötigt eine Anhängerkupplung, eine geeignete Anhängelast und die passende elektrische Verbindung. Bitte prüfe vorab die zulässigen Werte von Zugfahrzeug, Anhänger und Gespann.</p>",
            "enable_highlight": false,
            "highlight_style": "marker"
          }
        },
        "question_yRxfbP": {
          "type": "question",
          "settings": {
            "title": "Benötige ich einen speziellen Führerschein?",
            "text": "<p>Für den Besttrailers KFZ-Transportanhänger wird in der Regel die Führerscheinklasse BE benötigt, da das zulässige Gesamtgewicht des Gespanns 3,5 t überschreiten kann. Bitte prüfe deine konkrete Kombination vorab.</p>",
            "enable_highlight": false,
            "highlight_style": "marker"
          }
        },

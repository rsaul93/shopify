eight:280px;\n  border:0;\n  border-radius:10px;\n  box-shadow:0 6px 16px rgba(0,0,0,.08);\n}\n\n.cp-map-link{\n  display:block;\n  margin-top:6px;\n  font-size:13px;\n  opacity:.7;\n}\n\n.cp-map-link a{\n  color:inherit;\n}\n\n</style>\n\n<!-- Local SEO Markup -->\n<script type=\"application/ld+json\">\n{\n \"@context\": \"https://schema.org\",\n \"@type\": \"LocalBusiness\",\n \"name\": \"Camping Pioneers Showroom Pettstadt\",\n \"address\": {\n   \"@type\": \"PostalAddress\",\n   \"streetAddress\": \"Eichenhof 1b\",\n   \"addressLocality\": \"Pettstadt\",\n   \"postalCode\": \"96175\",\n   \"addressCountry\": \"DE\"\n },\n \"geo\": {\n   \"@type\": \"GeoCoordinates\",\n   \"latitude\": 49.831000,\n   \"longitude\": 10.918847\n },\n \"url\": \"https://www.camping-pioneers.de/pages/showroom\"\n}\n</script>"

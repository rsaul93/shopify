    "faq_ynj8Y4": {
      "type": "faq",
      "blocks": {
        "question_ApNfHE": {
          "type": "question",
          "settings": {
            "title": "Wie hoch sind die Kosten für die Dachzelt-Miete?",
            "text": "<p>Die Kosten hängen vom gewählten Dachzelt, der Mietdauer und optionalem Zubehör ab. Im Mietrechner auf dieser Seite siehst du den Preis vor dem Absenden deiner Anfrage.</p>",
            "enable_highlight": false,
            "highlight_style": "marker"
          }
        },
        "question_BtU4nK": {
          "type": "question",
          "settings": {
            "title": "Kann ich mir die Dachzelte vor der Miete ansehen?",
            "text": "<p>Ja. Du kannst die Dachzelte in unseren <a href=\"/pages/showrooms\" target=\"_blank\" title=\"Camping Pioneers Showrooms – Dachzelte & Anhänger live erleben\"><strong>Showrooms</strong></a><strong> in Bad Berka oder Pettstadt persönlich ansehen und dich beraten lassen. Vereinbare hierzu bitte vorab einen Termin, da unsere Showrooms nicht durchgehend besetzt sind.</strong></p>",
            "enable_highlight": false,
            "highlight_style": "marker"
          }
        },
        "question_EqkNhe": {
          "type": "question",
          "settings": {
            "title": "Wie erfolgt die Bezahlung?",
            "text": "<p>Du kannst per <strong>Barzahlung, EC-Karte, PayPal oder Überweisung</strong> bezahlen. Alle Zahlungsdetails erhältst du mit deiner Buchungsbestätigung. Die Zahlung erfolgt in der Regel bei Abholung.</p>",
            "enable_highlight": false,
            "highlight_style": "marker"
          }
        },
        "question_rLVrEq": {
          "type": "question",
          "settings": {
            "title": "Wie hoch ist die Kaution für die Dachzelt-Miete?",
            "text": "<p>Die Kaution beträgt <strong>500 € pro Dachzelt</strong>. Sie wird bei der Übergabe hinterlegt und nach ordnungsgemäßer Rückgabe vollständig erstattet.</p>",
            "enable_highlight": false,
            "highlight_style": "marker"
          }
        },
        "question_FwHGr4": {
          "type": "question",
          "settings": {
            "title": "Wie lange ist die Mindestmietdauer?",
            "text": "<p>Die ersten 4 Tage werden pauschal berechnet. Kürzere Zeiträume kannst du anfragen, preislich bleibt die 4-Tage-Pauschale die Basis.</p>",
            "enable_highlight": false,
            "highlight_style": "marker"
          }
        },
        "question_XWrwWa": {
          "type": "question",
          "settings": {
            "title": "Kann ich das Dachzelt nach der Miete kaufen?",
            "text": "<p>Ja. Wenn du dich nach der Miete für den Kauf entscheidest, werden dir <strong>50 % der gezahlten Miete auf den Kaufpreis angerechnet.</strong></p><p></p>",
            "enable_highlight": false,
            "highlight_style": "marker"
          }
        },
        "question_t79jzr": {
          "type": "question",

    "rich_text_3WBrLM": {
      "type": "rich-text",
      "blocks": {
        "heading_3QHmTz": {
          "type": "heading",
          "settings": {
            "heading": "Welches Dachzelt passt am besten zu dir?",
            "heading_size": "h1",
            "heading_tag": "h2"
          }
        },
        "text_zYKghj": {
          "type": "text",
          "settings": {
            "text": "<h2>Wähle Qeedo, wenn du ein leichtes und preiswertes Dachzelt suchst<\/h2><p>Perfekt für Einsteiger, Wochenend-Trips und alle, die ein unkompliziertes Dachzelt mit sehr gutem Preis-Leistungs-Verhältnis möchten.<\/p><h2>Wähle VICKYWOOD, wenn Komfort für dich an erster Stelle steht<\/h2><p>Ideal für lange Reisen, Vanlife und alle, die besonders bequem und komfortabel unterwegs sein möchten.<\/p><h2>Wähle Horntools, wenn du maximale Stabilität und Offroad-Tauglichkeit brauchst<\/h2><p>Die beste Wahl für Abenteurer, Offroad-Fans und intensive Nutzung unter anspruchsvollen Bedingungen.<\/p><h3><strong>Fazit: Drei Hersteller – drei perfekte Einsatzbereiche<\/strong><\/h3><p>Alle drei Dachzelt Hersteller bieten hochwertige und zuverlässige Lösungen. Die richtige Wahl hängt vor allem von deinen persönlichen Anforderungen ab:<\/p><ul><li><h4><strong>Qeedo:<\/strong> beste Wahl für Einsteiger und Preis-Leistung<br\/><\/h4><\/li><li><h4><strong>VICKYWOOD:<\/strong> beste Wahl für Komfort und Premium Camping<br\/><\/h4><\/li><li><h4><strong>Horntools:<\/strong> beste Wahl für Offroad und maximale Robustheit<\/h4><\/li><\/ul><p><\/p><p><\/p>",
            "text_size": "typeset2",
            "secondary_color": false,
            "highlight_style": "marker"
          }
        }
      },

      "settings": {
        "custom_liquid": "<style>\n\n\/* Tabelle *\/\n\n.compare-table{\nwidth:100%;\nborder-collapse:separate;\nborder-spacing:0;\nborder-radius:12px;\noverflow:hidden;\nborder:1px solid #e5e7eb;\nfont-family:inherit;\nmargin-bottom:10px;\n}\n\n\n.compare-table th{\n\nbackground:#f9fafb;\npadding:16px;\ntext-align:left;\nfont-weight:600;\n\n}\n\n\n.compare-table td{\n\npadding:16px;\nborder-top:1px solid #eee;\n\n}\n\n\n.compare-table tr:hover{\n\nbackground:#f9fafb;\n\n}\n\n\n\/* Premium Highlight *\/\n\n.best-choice{\n\nborder-left:4px solid #f5b301;\nbackground:#fffdf7;\n\n}\n\n\n\/* Sterne *\/\n\n.star-gold{\n\ncolor:#f5b301;\nfont-size:18px;\nletter-spacing:2px;\n\n}\n\n.star-grey{\n\ncolor:#d1d5db;\nfont-size:18px;\nletter-spacing:2px;\n\n}\n\n\n\/* Button im Camping Pioneers Stil *\/\n\n.compare-btn{\n\nbackground:#092C91;\ncolor:#ffffff;\npadding:10px 16px;\nborder-radius:8px;\ntext-decoration:none;\nfont-weight:600;\ndisplay:inline-block;\ntransition:0.2s;\n\n}\n\n.compare-btn:hover{\n\nbackground:#071f66;\ncolor:#ffffff;\n\n}\n\n\n\/* Disclaimer *\/\n\n.compare-disclaimer{\n\nfont-size:12px;\ncolor:#6b7280;\nmargin-top:6px;\nline-height:1.5;\n\n}\n\n<\/style>\n\n\n\n<table class=\"compare-table\">\n\n\n<tr>\n\n<th>Hersteller<\/th>\n<th>Komfort<\/th>\n<th>Gewicht<\/th>\n<th>Robustheit<\/th>\n<th>Ideal für<\/th>\n<th><\/th>\n\n<\/tr>\n\n\n\n<tr class=\"best-choice\">\n\n<td>\n\n<strong>VICKYWOOD<\/strong><br>\n\nPremium Komfort\n\n<\/td>\n\n\n<td>\n\n<span class=\"star-gold\">★★★★★<\/span>\n\n<\/td>\n\n\n<td>\n\n<span class=\"star-gold\">★★★<\/span><span class=\"star-grey\">★★<\/span>\n\n<\/td>\n\n\n<td>\n\n<span class=\"star-gold\">★★★★<\/span><span class=\"star-grey\">★<\/span>\n\n<\/td>\n\n\n<td>\n\nVanlife & lange Reisen\n\n<\/td>\n\n\n<td>\n\n<a href=\"\/collections\/vickywood\" class=\"compare-btn\">\n\nAnsehen →\n\n<\/a>\n\n<\/td>\n\n<\/tr>\n\n\n\n\n<tr>\n\n<td>\n\n<strong>Horntools<\/strong><br>\n\nMaximale Stabilität\n\n<\/td>\n\n\n<td>\n\n<span class=\"star-gold\">★★★★<\/span><span class=\"star-grey\">★<\/span>\n\n<\/td>\n\n\n<td>\n\n<span class=\"star-gold\">★★★<\/span><span class=\"star-grey\">★★<\/span>\n\n<\/td>\n\n\n<td>\n\n<span class=\"star-gold\">★★★★★<\/span>\n\n<\/td>\n\n\n<td>\n\nOffroad & Expedition\n\n<\/td>\n\n\n<td>\n\n<a href=\"\/collections\/horntools-dachzelte\" class=\"compare-btn\">\n\nAnsehen →\n\n<\/a>\n\n<\/td>\n\n<\/tr>\n\n\n\n\n<tr>\n\n<td>\n\n<strong>Qeedo<\/strong><br>\n\nPreis-Leistungs Sieger\n\n<\/td>\n\n\n<td>\n\n<span class=\"star-gold\">★★★★<\/span><span class=\"star-grey\">★<\/span>\n\n<\/td>\n\n\n<td>\n\n<span class=\"star-gold\">★★★★★<\/span>\n\n<\/td>\n\n\n<td>\n\n<span class=\"star-gold\">★★★<\/span><span class=\"star-grey\">★★<\/span>\n\n<\/td>\n\n\n<td>\n\nEinsteiger & Allround\n\n<\/td>\n\n\n<td>\n\n<a href=\"\/collections\/qeedo-dachzelt\" class=\"compare-btn\">\n\nAnsehen →\n\n<\/a>\n\n<\/td>\n\n<\/tr>\n\n\n<\/table>\n\n\n\n<div class=\"compare-disclaimer\">\n\n*Bewertungen basieren auf typischer Markenpositionierung, Materialien, Komfort, Gewicht und Einsatzzweck. Je nach Modell können Eigenschaften variieren. Detaillierte Informationen findest du auf den jeweiligen Produktseiten.*\n\n<\/div>",

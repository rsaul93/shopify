    "custom_liquid_xWQtW4": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<style>\n\n.guide-section{\n\nbackground:#f8fafc;\nborder-radius:12px;\npadding:28px;\nmargin-top:40px;\nmargin-bottom:20px;\n\n}\n\n\n.guide-title{\n\nfont-size:22px;\nfont-weight:700;\nmargin-bottom:10px;\n\n}\n\n\n.guide-text{\n\nfont-size:15px;\ncolor:#374151;\nmargin-bottom:20px;\nline-height:1.6;\n\n}\n\n\n.guide-button{\n\nbackground:#092C91;\ncolor:#ffffff;\npadding:12px 20px;\nborder-radius:8px;\ntext-decoration:none;\nfont-weight:600;\ndisplay:inline-block;\ntransition:0.2s;\n\n}\n\n\n.guide-button:hover{\n\nbackground:#071f66;\ncolor:#ffffff;\n\n}\n\n<\/style>\n\n\n\n<div class=\"guide-section\">\n\n\n<div class=\"guide-title\">\n\nDachzelt Ratgeber – Alles was du wissen musst\n\n<\/div>\n\n\n<div class=\"guide-text\">\n\nDu bist dir noch unsicher, welches Dachzelt das richtige für dich ist oder wie die Montage funktioniert? In unserem umfassenden Dachzelt Ratgeber erfährst du alles über Einsatzmöglichkeiten, Vorteile, Montage und wichtige Kaufkriterien – ideal für Einsteiger und erfahrene Camper.\n\n<\/div>\n\n\n<a href=\"\/pages\/der-umfassende-ratgeber-fur-dachzelte-einsatzmoglichkeiten-und-montage\" class=\"guide-button\">\n\nZum Dachzelt Ratgeber →\n\n<\/a>\n\n\n<\/div>",
        "full_width": false,
        "show_divider": false,
        "padding_top": 36,
        "padding_bottom": 36
      }
    },
    "faq_8RiTty": {
      "type": "faq",
      "blocks": {
        "question_L38zXA": {
          "type": "question",
          "settings": {
            "title": "Welches Dachzelt ist das beste?",
            "text": "<p>Das beste Dachzelt hängt von deinem Fahrzeug, deinem Reiseverhalten und deinem Komfortanspruch ab. Premium Dachzelte bieten meist mehr Schlafkomfort, langlebigere Materialien und eine robustere Bauweise. Leichtere Modelle sind dafür oft preislich attraktiver und einfacher zu handhaben. Ein Vergleich verschiedener Hersteller hilft dir, das passende Dachzelt für deine individuellen Anforderungen zu finden.<\/p>"
          }
        },
        "question_4fEe9K": {
          "type": "question",
          "settings": {
            "title": "Welche Dachzelt Hersteller sind die besten?",
            "text": "<p>Zu den beliebtesten und bewährtesten Dachzelt Herstellern gehören Marken wie VICKYWOOD, Horntools und Qeedo. Sie bieten unterschiedliche Stärken – von besonders komfortablen Premium Dachzelten über extrem robuste Offroad-Modelle bis hin zu leichten und vielseitigen Dachzelten mit sehr gutem Preis-Leistungs-Verhältnis.<\/p>"
          }
        },
        "question_nEWGTW": {
          "type": "question",
          "settings": {
            "title": "Worauf sollte ich beim Dachzelt Vergleich achten?",
            "text": "<p>Die wichtigsten Kriterien beim Dachzelt Vergleich sind:<\/p><ul><li>Gewicht und Kompatibilität mit deinem Fahrzeug<br\/><\/li><li>Schlafkomfort und Matratzenqualität<br\/><\/li><li>Material und Wetterbeständigkeit<br\/><\/li><li>Aufbauzeit und Handhabung<br\/><\/li><li>Preis-Leistungs-Verhältnis<br\/><\/li><\/ul><p>Diese Faktoren entscheiden darüber, wie komfortabel und langlebig dein Dachzelt ist.<\/p>"
          }
        },
        "question_9rhNdh": {
          "type": "question",
          "settings": {
            "title": "Ist ein teureres Dachzelt besser?",
            "text": "<p>Hochwertigere Dachzelte bieten in der Regel bessere Materialien, höheren Schlafkomfort und eine längere Lebensdauer. Wenn du dein Dachzelt regelmäßig nutzt oder längere Reisen planst, kann sich die Investition in ein Premium Dachzelt langfristig auszahlen.<\/p>"
          }
        },
        "question_hnd7zd": {
          "type": "question",
          "settings": {
            "title": "Welches Dachzelt ist für Einsteiger geeignet?",
            "text": "<p>Einsteiger profitieren besonders von Dachzelten, die einfach zu montieren und leicht zu bedienen sind. Viele moderne Dachzelte sind heute so konstruiert, dass sie sich schnell aufbauen lassen und sofort einsatzbereit sind.<\/p>"
          }
        },
        "question_a7FAV6": {
          "type": "question",
          "settings": {
            "title": "Passt ein Dachzelt auf jedes Auto?",
            "text": "<p>In den meisten Fällen ja. Voraussetzung ist ein geeigneter Dachträger und die Einhaltung der maximalen Dachlast deines Fahrzeugs. Dachzelte können auf vielen Fahrzeugtypen montiert werden, darunter:<\/p><ul><li>Kleinwagen<br\/><\/li><li>SUVs<br\/><\/li><li>Vans<br\/><\/li><li>Geländewagen<\/li><\/ul>"
          }
        },
        "question_i6Q8mP": {
          "type": "question",
          "settings": {
            "title": "Wie viel kostet ein gutes Dachzelt?",
            "text": "<p>Gute Dachzelte kosten in der Regel zwischen etwa 1.000 € und 4.000 €, abhängig von Ausstattung, Komfort und Materialqualität. Hochwertigere Modelle bieten oft mehr Komfort und sind für langfristige Nutzung ausgelegt.<\/p>"
          }
        },
        "question_47nryY": {
          "type": "question",
          "settings": {
            "title": "Wie lange hält ein Dachzelt?",
            "text": "<p>Ein hochwertiges Dachzelt kann bei richtiger Nutzung und Pflege viele Jahre halten. Besonders Premium Dachzelte sind für langfristige Nutzung und häufiges Reisen konzipiert.<\/p>"
          }
        },
        "question_feqmzF": {
          "type": "question",
          "settings": {
            "title": "Welches Dachzelt ist für lange Reisen am besten geeignet?",
            "text": "<p>Für längere Reisen eignen sich besonders Dachzelte mit hohem Schlafkomfort, stabiler Bauweise und langlebigen Materialien. Diese bieten ein angenehmes Schlafgefühl und sind auf regelmäßige Nutzung ausgelegt.<\/p>"
          }
        },
        "question_K4jJgt": {
          "type": "question",
          "settings": {
            "title": "Lohnt sich ein Dachzelt?",
            "text": "<p>Ein Dachzelt lohnt sich für alle, die flexibel, komfortabel und unabhängig reisen möchten. Es ermöglicht spontane Übernachtungen und bietet eine praktische Alternative zu klassischen Campinglösungen.<\/p>"
          }
        }
      },

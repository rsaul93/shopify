          }
        },
        "testimonial_HPa6Qg": {
          "type": "testimonial",
          "settings": {
            "icon": "5",
            "text": "<p>ich würde 10 Sterne geben, wenn es ginge... Da können sich andere Händler eine Scheibe abschneiden. Toller Support, schnell geliefert alles Super. Da Kauft man auch gerne wieder Respekt<\/p>",

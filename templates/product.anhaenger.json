      "blocks": {
        "collapsible_row_JjPRcA": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Für wen ist dieser Anhänger gedacht?",
            "row_content": "<p>Für alle, die einen <strong>kleinen, soliden und funktionellen Anhänger</strong> suchen – alltagstauglich, leicht zu handhaben.</p>",
            "page": ""
          }
        },
        "collapsible_row_PNwcjj": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Was bringt ein Stützrad – und was kostet es bei euch?",
            "row_content": "<p>Ein Stützrad macht <strong>An- und Abkuppeln</strong> sowie <strong>Rangieren von Hand</strong> deutlich einfacher und kontrollierter (besonders auf Hof/Einfahrt/Stellplatz).<br/><br/>Bei CampingPioneers: <strong>optional +30 €</strong> (Variante „mit Stützrad“).</p>",
            "page": ""
          }
        },
        "collapsible_row_qGH6Um": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Welche Plane passt auf dieses Modell?",
            "row_content": "<p>Für <strong>GN102</strong> sind u. a. gelistet:</p><ul><li><strong>Flachplane (650 g/m²)</strong> <br/></li><li><strong>Hochplane 800 mm (650 g/m²) + Spriegel 800 mm</strong> </li></ul>",
            "page": ""
          }
        },
        "collapsible_row_WDbVbE": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Kann ich ihn mit unterschiedlichen zGG zulassen?",
            "row_content": "<p>Ja – Neptun nennt Registrierungsvarianten mit <strong>DMC/zGG 350 bis 750 kg</strong> (abhängig von der jeweiligen Registrierung/Zulassung).</p>",
            "page": ""
          }
        },
        "collapsible_row_ECVF7b": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Welche Innenmaße hat die Ladefläche?",
            "row_content": "<p><strong>202 × 114 × 30 cm (L × B × H)</strong> Innenabmessungen.</p>",
            "page": ""
          }
        },
        "collapsible_row_MeLC7h": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Wie viel darf ich laden?",
            "row_content": "<p><strong>Zulässiges Gesamtgewicht:</strong> 750 kg </p><p><br/><strong>Nutzlast:</strong> 624 kg </p>",
            "page": ""
          }
        },
        "collapsible_row_cfhG8D": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Ist der Anhänger gebremst?",
            "row_content": "<p>Nein, dieses Modell ist <strong>ungebremst</strong>. </p>",
            "page": ""
          }
        }
      },

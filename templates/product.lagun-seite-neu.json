d: rgba(0,0,0,0.22);\n      cursor: pointer;\n      padding: 0;\n    }\n\n    #cp-size-guide-{{ product.id }} .cp-size-guide__dot.is-active {\n      background: rgba(0,0,0,0.65);\n    }\n\n    @media screen and (max-width: 749px) {\n      #cp-size-guide-{{ product.id }} {\n        max-width: 100%;\n      }\n\n      #cp-size-guide-{{ product.id }} .cp-size-guide__slider {\n        grid-template-columns: 1fr;\n      }\n\n      #cp-size-guide-{{ product.id }} .cp-size-guide__arrow {\n        display: none;\n      }\n\n      #cp-size-guide-{{ product.id }} .cp-size-guide__slide img {\n        max-height: 280px;\n      }\n\n      #cp-size-guide-{{ product.id }} .cp-size-guide__header h3 {\n        font-size: 17px;\n      }\n    }\n  <\/style>\n\n  <script>\n    (function() {\n      function normalize(value) {\n        return String(value || '')\n          .toLowerCase()\n          .replace(\/ä\/g, 'ae')\n          .replace(\/ö\/g, 'oe')\n          .replace(\/ü\/g, 'ue')\n          .replace(\/ß\/g, 'ss')\n          .replace(\/\\s+\/g, '')\n          .replace(\/-\/g, '')\n          .replace(\/_\/g, '')\n          .replace(\/cm\/g, '');\n      }\n\n      function getNumbers(value) {\n        return String(value || '').match(\/\\d+\/g) || [];\n      }\n\n      function initSizeGuide(root) {\n        if (!root || root.dataset.cpReady === 'true') return;\n\n        var track = root.querySelector('.cp-size-guide__track');\n        var slides = root.querySelectorAll('.cp-size-guide__slide');\n        var dots = root.querySelectorAll('.cp-size-guide__dot');\n        var productJson = root.querySelector('[data-product-json]');\n\n        if (!track || !slides.length) return;\n\n        var productData = null;\n        var currentIndex = 0;\n\n        try {\n          productData = productJson ? JSON.parse(productJson.textContent) : null;\n        } catch(e) {}\n\n        function updateSlider() {\n          track.style.transform = 'translateX(-' + (currentIndex * 100) + '%)';\n\n          dots.forEach(function(dot, index) {\n            dot.classList.toggle('is-active', index === currentIndex);\n          });\n        }\n\n        function goToSlide(index) {\n          if (index < 0) index = slides.length - 1;\n          if (index >= slides.length) index = 0;\n\n          currentIndex = index;\n          updateSlider();\n        }\n\n        function findSizeOptionIndex() {\n          if (!productData || !productData.options) return -1;\n\n          for (var i = 0; i < productData.options.length; i++) {\n            var name = normalize(productData.options[i]);\n\n            if (\n              name.indexOf('groesse') !== -1 ||\n              name.indexOf('grosse') !== -1 ||\n              name.indexOf('size') !== -1 ||\n              name.indexOf('breite') !== -1 ||\n              name.indexOf('mass') !== -1 ||\n              name.indexOf('masse') !== -1\n            ) {\n              return i;\n            }\n          }\n\n          return -1;\n        }\n\n        function getProductForm() {\n          return root.closest('section') && root.closest('section').querySelector('form[action*=\"\/cart\/add\"]')\n            ? root.closest('section').querySelector('form[action*=\"\/cart\/add\"]')\n            : document.querySelector('form[action*=\"\/cart\/add\"]');\n        }\n\n        function getSelectedSizeValue() {\n          var sizeIndex = findSizeOptionIndex();\n          if (sizeIndex === -1 || !productData) return null;\n\n          var form = getProductForm();\n          var optionName = productData.options[sizeIndex];\n          var normalizedOptionName = normalize(optionName);\n\n          if (form) {\n            var checkedRadios = form.querySelectorAll('input[type=\"radio\"]:checked');\n\n            for (var r = 0; r < checkedRadios.length; r++) {\n              var radioName = normalize(checkedRadios[r].name);\n\n              if (\n                radioName.indexOf(normalizedOptionName) !== -1 ||\n                radioName.indexOf('option' + (sizeIndex + 1)) !== -1 ||\n                radioName.indexOf('options') !== -1\n              ) {\n                return checkedRadios[r].value;\n              }\n            }\n\n            var selects = form.querySelectorAll('select');\n\n            for (var s = 0; s < selects.length; s++) {\n              var selectName = normalize(selects[s].name);\n\n              if (\n                selectName.indexOf(normalizedOptionName) !== -1 ||\n                selectName.indexOf('option' + (sizeIndex + 1)) !== -1 ||\n                selectName.indexOf('options') !== -1\n              ) {\n                return selects[s].value;\n              }\n            }\n          }\n\n          var variantInput = form ? form.querySelector('[name=\"id\"]') : document.querySelector('[name=\"id\"]');\n\n          if (variantInput && productData.variants) {\n            var variantId = Number(variantInput.value);\n\n            for (var v = 0; v < productData.variants.length; v++) {\n              if (Number(productData.variants[v].id) === variantId) {\n                return productData.variants[v].options[sizeIndex];\n              }\n            }\n          }\n\n          return null;\n        }\n\n        function goToMatchingSizeImage() {\n          var selectedSize = getSelectedSizeValue();\n          if (!selectedSize) return;\n\n          var selectedNormalized = normalize(selectedSize);\n          var selectedNumbers = getNumbers(selectedSize);\n\n          var matchedIndex = -1;\n\n          slides.forEach(function(slide, index) {\n            if (matchedIndex !== -1) return;\n\n            var searchText = normalize(slide.getAttribute('data-search'));\n\n            if (searchText.indexOf(selectedNormalized) !== -1) {\n              matchedIndex = index;\n              return;\n            }\n\n            selectedNumbers.forEach(function(number) {\n              if (matchedIndex === -1 && searchText.indexOf(number) !== -1) {\n                matchedIndex = index;\n              }\n            });\n          });\n\n          if (matchedIndex !== -1) {\n            goToSlide(matchedIndex);\n          }\n        }\n\n        root.addEventListener('click', function(event) {\n          var prev = event.target.closest('.cp-size-guide__arrow--prev');\n          var next = event.target.closest('.cp-size-guide__arrow--next');\n          var dot = event.target.closest('.cp-size-guide__dot');\n\n          if (prev) {\n            event.preventDefault();\n            goToSlide(currentIndex - 1);\n          }\n\n          if (next) {\n            event.preventDefault();\n            goToSlide(currentIndex + 1);\n          }\n\n          if (dot) {\n            event.preventDefault();\n            goToSlide(parseInt(dot.getAttribute('data-index'), 10));\n          }\n        });\n\n        var startX = 0;\n\n        root.addEventListener('touchstart', function(event) {\n          if (!event.target.closest('.cp-size-guide__viewport')) return;\n          startX = event.changedTouches[0].clientX;\n        }, { passive: true });\n\n        root.addEventListener('touchend', function(event) {\n          if (!event.target.closest('.cp-size-guide__viewport')) return;\n\n          var endX = event.changedTouches[0].clientX;\n          var diff = startX - endX;\n\n          if (Math.abs(diff) > 40) {\n            diff > 0 ? goToSlide(currentIndex + 1) : goToSlide(currentIndex - 1);\n          }\n        }, { passive: true });\n\n        function delayedMatch() {\n          setTimeout(goToMatchingSizeImage, 250);\n          setTimeout(goToMatchingSizeImage, 700);\n        }\n\n        document.addEventListener('change', delayedMatch);\n\n        document.addEventListener('click', function(event) {\n          if (\n            event.target.matches('input[type=\"radio\"]') ||\n            event.target.matches('label') ||\n            event.target.closest('variant-radios') ||\n            event.target.closest('variant-selects') ||\n            event.target.closest('.product-form__input')\n          ) {\n            delayedMatch();\n          }\n        });\n\n        document.addEventListener('variant:change', delayedMatch);\n        document.addEventListener('product:variant-change', delayedMatch);\n        document.addEventListener('variant:changed', delayedMatch);\n\n        root.dataset.cpReady = 'true';\n\n        updateSlider();\n        delayedMatch();\n      }\n\n      function initAllSizeGuides() {\n        document.querySelectorAll('[data-size-guide]').forEach(initSizeGuide);\n      }\n\n      initAllSizeGuides();\n\n      document.addEventListener('shopify:section:load', initAllSizeGuides);\n\n      var observer = new MutationObserver(function() {\n        initAllSizeGuides();\n      });\n\n      observer.observe(document.body, {\n        childList: true,\n        subtree: true\n      });\n    })();\n  <\/script>\n{% endif %}"

            "custom_liquid": "{% assign size_images = product.metafields.custom.grosen_mase.value %}\n\n{% if size_images != blank and size_images.size > 0 %}\n  <div class=\"cp-size-guide\" id=\"cp-size-guide-{{ product.id }}\" data-size-guide>\n    <script type=\"application\/json\" data-product-json>\n      {{ product | json }}\n    <\/script>\n\n    <div class=\"cp-size-guide__header\">\n      <h3>Größen & Maße<\/h3>\n    <\/div>\n\n    <div class=\"cp-size-guide__slider\">\n      <button class=\"cp-size-guide__arrow cp-size-guide__arrow--prev\" type=\"button\" aria-label=\"Vorheriges Bild\">‹<\/button>\n\n      <div class=\"cp-size-guide__viewport\">\n        <div class=\"cp-size-guide__track\">\n          {% for media in size_images %}\n            {% assign image_url = media | image_url: width: 1200 %}\n            <div\n              class=\"cp-size-guide__slide\"\n              data-search=\"{{ media.alt | default: product.title | downcase | escape }} {{ image_url | downcase | escape }}\"\n            >\n              <img\n                src=\"{{ image_url }}\"\n                alt=\"{{ media.alt | default: product.title | escape }}\"\n                loading=\"lazy\"\n              >\n            <\/div>\n          {% endfor %}\n        <\/div>\n      <\/div>\n\n      <button class=\"cp-size-guide__arrow cp-size-guide__arrow--next\" type=\"button\" aria-label=\"Nächstes Bild\">›<\/button>\n    <\/div>\n\n    {% if size_images.size > 1 %}\n      <div class=\"cp-size-guide__dots\">\n        {% for media in size_images %}\n          <button\n            class=\"cp-size-guide__dot{% if forloop.first %} is-active{% endif %}\"\n            type=\"button\"\n            aria-label=\"Bild {{ forloop.index }} anzeigen\"\n            data-index=\"{{ forloop.index0 }}\"\n          ><\/button>\n        {% endfor %}\n      <\/div>\n    {% endif %}\n  <\/div>\n\n  <style>\n    #cp-size-guide-{{ product.id }} {\n      margin-top: 22px;\n      max-width: 760px;\n    }\n\